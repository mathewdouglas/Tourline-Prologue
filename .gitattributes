# Overlay runtime patches are applied with git apply on top of the main patch;
# keep their LF bytes so a Windows checkout does not break them.
patches/*.patch text eol=lf
# The runtime has a few mixed-newline headers. Preserve the patch's literal
# context bytes; normalizing CRLF during commit/checkout breaks clean installs.
patches/ps3recomp-4e8f3ca8-local.patch -text
# Metadata shards have byte-level checksums; preserve their LF bytes on Windows.
assets/pipeline-templates/**/part-*.json text eol=lf
# Warmup plans hash bundle indices too; their bytes must survive Windows checkout.
assets/pipeline-templates/**/index.json text eol=lf
