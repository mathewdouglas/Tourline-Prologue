+/* RSX_VFETCH_LOOP (developer experiment, default off; unset/0 leaves the generated text byte-identical):
+ *   1  the helper's 4-component loop is a real loop instead of [unroll]
+ *   2  as 1, and one loop over the literal attribute mask replaces the inlined fetch per attribute
+ * Either changes the shader source, so its source key and bytecode differ from the default. A cache or
+ * starter prepared with one setting does not serve the other: prepare and run with the same value. */
+static int vfetch_loop_mode(void)
+{
+    static int mode = -1;
+    if (mode < 0) {
+        const char* e = getenv("RSX_VFETCH_LOOP");
+        mode = (e && (e[0] == '1' || e[0] == '2') && !e[1]) ? e[0] - '0' : 0;
+    }
+    return mode;
+}
+
+static void emit_vfetch_helpers(Out* o)
+{
+    static const char unrolled[] = "[unroll] for (uint i = 0; i < 4u; i++) {";
+    const char* at = vfetch_loop_mode() ? strstr(k_vfetch_hlsl, unrolled) : NULL;
+    if (!at) { emit(o, k_vfetch_hlsl); return; }
+    char text[sizeof k_vfetch_hlsl + 8];
+    size_t head = (size_t)(at - k_vfetch_hlsl);
+    memcpy(text, k_vfetch_hlsl, head);
+    memcpy(text + head, "[loop]", 6);
+    strcpy(text + head + 6, at + 8);          /* skip "[unroll]" */
+    emit(o, text);
+}
