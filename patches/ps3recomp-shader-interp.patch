+
+static void fp_interp_bind(const D3D12DrawRecord* dr, u32 draw_i, u32 hdr_off)
+{
+    if (!dr || draw_i >= MAX_DRAWS || !s_d3d.srv_heap || !s_d3d.cmd_list) return;
+    int par = FR->parity & 1;
+    if (!s_interp_arena[par]) return;
+    u32 base = SRV_HEAP_ALLOC + 48u + draw_i * 48u;
+    u32 tmpl = SRV_HEAP_ALLOC;
+    s_d3d.device->lpVtbl->CopyDescriptorsSimple(s_d3d.device, 16,
+        fp_interp_cpu(base), fp_interp_cpu(tmpl), D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+    s_d3d.device->lpVtbl->CopyDescriptorsSimple(s_d3d.device, 16,
+        fp_interp_cpu(base + 16), fp_interp_cpu(tmpl + 16), D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+    s_d3d.device->lpVtbl->CopyDescriptorsSimple(s_d3d.device, 16,
+        fp_interp_cpu(base + 32), fp_interp_cpu(tmpl + 32), D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+    u32 shape = fp_interp_shape(dr);
+    for (u32 u = 0; u < RSX_TEX_UNITS; u++) {
+        u32 s = (shape >> (u * 2)) & 3u;
+        u32 range = s == 1u ? 16u : s == 2u ? 32u : 0u;
+        s_d3d.device->lpVtbl->CopyDescriptorsSimple(s_d3d.device, 1,
+            fp_interp_cpu(base + range + u),
+            fp_interp_cpu(DRAW_SRV_BASE + draw_i * RSX_TEX_UNITS + u),
+            D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+    }
+    D3D12_GPU_DESCRIPTOR_HANDLE gh;
+    s_d3d.srv_heap->lpVtbl->GetGPUDescriptorHandleForHeapStart(s_d3d.srv_heap, &gh);
+    gh.ptr += (UINT64)base * s_d3d.srv_inc;
+    s_d3d.cmd_list->lpVtbl->SetGraphicsRootDescriptorTable(s_d3d.cmd_list, 1, gh);
+    s_d3d.cmd_list->lpVtbl->SetGraphicsRootShaderResourceView(s_d3d.cmd_list, 5,
+        s_interp_arena[par]->lpVtbl->GetGPUVirtualAddress(s_interp_arena[par]));
+    UINT c[4] = { hdr_off, 0, 0, 0 };
+    s_d3d.cmd_list->lpVtbl->SetGraphicsRoot32BitConstants(s_d3d.cmd_list, 6, 4, c, 0);
+}
