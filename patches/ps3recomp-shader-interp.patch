diff --git a/libs/video/rsx_vp_interp.h b/libs/video/rsx_vp_interp.h
new file mode 100644
index 0000000..6886810
--- /dev/null
+++ b/libs/video/rsx_vp_interp.h
@@ -0,0 +1,22 @@
+/*
+ * Vertex-interpreter shader shared by the engine and vp_interp_precompile.
+ * The body is scripts/test/vp_interp.hlsl. FETCH 1 is the GPU-fetch variant.
+ * The bytes are part of the DXBC cache key, so both callers use this prefix.
+ */
+#ifndef PS3RECOMP_RSX_VP_INTERP_H
+#define PS3RECOMP_RSX_VP_INTERP_H
+
+static int rsx_vp_interp_variant_prefix(char* dst, unsigned cap, int fetch)
+{
+    int n;
+    if (!dst || cap < 8u) return -1;
+    n = snprintf(dst, cap, "#define RSX_VP_INTERP_FETCH %d\n", fetch ? 1 : 0);
+    if (n < 0 || (unsigned)n >= cap) return -1;
+    return n;
+}
+
+#ifdef RSX_VP_INTERP_EMBED_HLSL
+#include "rsx_vp_interp_hlsl.inc"
+#endif
+
+#endif
diff --git a/libs/video/rsx_vp_interp_backend.inc b/libs/video/rsx_vp_interp_backend.inc
new file mode 100644
index 0000000..eb85ca7
--- /dev/null
+++ b/libs/video/rsx_vp_interp_backend.inc
@@ -0,0 +1,384 @@
+/* Vertex-interpreter replay. Included at the bottom of rsx_d3d12_backend.c.
+ * RSX_SHADER_INTERP_VP unset or 0 returns before any allocation, signature,
+ * or binding. Force replaces the vertex stage and keeps the specialized
+ * pixel shader. Combined vertex/fragment interpretation uses the fragment
+ * signature, which also carries the vertex program and header. */
+
+#define RSX_VP_INTERP_EMBED_HLSL
+#include "rsx_vp_interp.h"
+
+static ID3D12RootSignature* s_vp_rs;
+static ID3DBlob* s_vp_vs[2];
+static ID3D12Resource* s_vp_arena[2];
+static u8* s_vp_map[2];
+static u32 s_vp_arena_bytes;
+static u32 s_vp_used[2];
+static u64 s_vp_tag[2];
+static ID3DBlob* s_vp_ps_hold;
+
+typedef struct { u32 hash; u32 off; u32 nbytes; } VpUp;
+static VpUp s_vp_up[2][1024];
+static u32 s_vp_up_n[2];
+
+/* Programs the recorder has seen. The record thread appends and the replay
+ * thread reads, so an entry is complete before the count that publishes it. */
+typedef struct { u32 hash, base, nbytes; u8* bytes; } VpSeen;
+#define VP_SEEN_MAX 1024
+static VpSeen s_vp_seen[VP_SEEN_MAX];
+static volatile LONG s_vp_seen_n;
+
+static char s_vp_src[131072];
+
+static struct {
+    u32 draws, fallback, miss, arena, pso_fail, arena_peak, compile_ms;
+} s_vp_stat;
+
+/* Configured mode: 0 off, 1 only while the specialized vertex shader is
+ * pending, 2 force. Fixed for the process; recording keys off it. */
+static int vp_interp_cfg(void)
+{
+    static int m = -1;
+    if (m >= 0) return m;
+    const char* e = getenv("RSX_SHADER_INTERP_VP");
+    if (!e || !e[0] || e[0] == '0') m = 0;
+    else if (e[0] == 'f' || e[0] == 'F') m = 2;
+    else if (e[0] == '1') m = 1;
+    else m = 0;
+    return m;
+}
+
+/* Mode for this replay frame (A/B alternation follows the fragment side). */
+static int vp_interp_mode(void)
+{
+    int m = vp_interp_cfg();
+    if (m && interp_ab() && !s_interp_ab_on) return 0;
+    return m;
+}
+
+static void vp_interp_note_fallback(void) { s_vp_stat.fallback++; }
+static void vp_interp_note_draw(void) { s_vp_stat.draws++; }
+
+static void vp_ps_hold_clear(void)
+{
+    if (!s_vp_ps_hold) return;
+    s_vp_ps_hold->lpVtbl->Release(s_vp_ps_hold);
+    s_vp_ps_hold = NULL;
+}
+
+static void vp_ps_hold_set(ID3DBlob* pb)
+{
+    if (!vp_interp_cfg() || !pb) return;
+    if (s_vp_ps_hold == pb) return;
+    if (s_vp_ps_hold) s_vp_ps_hold->lpVtbl->Release(s_vp_ps_hold);
+    pb->lpVtbl->AddRef(pb);
+    s_vp_ps_hold = pb;
+}
+
+static ID3DBlob* vp_ps_hold_ref(void)
+{
+    if (!vp_interp_cfg() || !s_vp_ps_hold) return NULL;
+    s_vp_ps_hold->lpVtbl->AddRef(s_vp_ps_hold);
+    return s_vp_ps_hold;
+}
+
+static UINT vp_interp_opt(void)
+{
+    static UINT f = 0xFFFFFFFFu;
+    if (f != 0xFFFFFFFFu) return f;
+    const char* e = getenv("RSX_SHADER_INTERP_VP_OPT");
+    f = !e ? 0u
+         : !strcmp(e, "skip") ? D3DCOMPILE_SKIP_OPTIMIZATION
+         : e[0] == '0' ? D3DCOMPILE_OPTIMIZATION_LEVEL0
+         : e[0] == '2' ? D3DCOMPILE_OPTIMIZATION_LEVEL2
+         : e[0] == '3' ? D3DCOMPILE_OPTIMIZATION_LEVEL3 : 0u;
+    return f;
+}
+
+static int vp_interp_uw(void)
+{
+    static int uw = -1;
+    if (uw < 0) { const char* e = getenv("RSX_ULTRAWIDE"); uw = e && e[0] && e[0] != '0'; }
+    return uw;
+}
+
+/* The specialized D3D12 vertex shader never calls rsx_vp_set_branch_base, so
+ * its branch targets are program-relative as written (base 0). The default
+ * matches it. RSX_SHADER_INTERP_VP_BASE=1 subtracts the program's start slot
+ * the way the live-draw path does. */
+static int vp_interp_base_rel(void)
+{
+    static int z = -1;
+    if (z < 0) { const char* e = getenv("RSX_SHADER_INTERP_VP_BASE"); z = e && e[0] == '1'; }
+    return z;
+}
+
+static void vp_interp_see(u32 hash, const u8* bytes, u32 nbytes, u32 base)
+{
+    if (!vp_interp_cfg()) return;
+    s_vp_seen_hash = hash;
+    if (!bytes || nbytes < 16u || (nbytes & 15u)) return;
+    LONG n = s_vp_seen_n;
+    for (LONG i = 0; i < n; i++)
+        if (s_vp_seen[i].hash == hash) return;
+    if (n >= VP_SEEN_MAX) return;
+    if (nbytes > 544u * 16u) nbytes = 544u * 16u;
+    u8* copy = (u8*)malloc(nbytes);
+    if (!copy) return;
+    memcpy(copy, bytes, nbytes);
+    VpSeen* s = &s_vp_seen[n];
+    s->hash = hash; s->base = base; s->nbytes = nbytes; s->bytes = copy;
+    MemoryBarrier();
+    s_vp_seen_n = n + 1;
+}
+
+static u32 vp_interp_last_hash(void)
+{
+    return vp_interp_cfg() ? s_vp_seen_hash : 0u;
+}
+
+static int vp_interp_find(u32 hash, const u8** bytes, u32* nbytes, u32* base)
+{
+    LONG n = s_vp_seen_n;
+    MemoryBarrier();
+    for (LONG i = 0; i < n; i++)
+        if (s_vp_seen[i].hash == hash && s_vp_seen[i].bytes) {
+            *bytes = s_vp_seen[i].bytes;
+            *nbytes = s_vp_seen[i].nbytes;
+            *base = s_vp_seen[i].base;
+            return 1;
+        }
+    return 0;
+}
+
+static ID3DBlob* vp_interp_blob(int fetch)
+{
+    int v = fetch ? 1 : 0;
+    if (s_vp_vs[v]) return s_vp_vs[v];
+    int n = rsx_vp_interp_variant_prefix(s_vp_src, sizeof s_vp_src, fetch);
+    size_t hl = strlen(rsx_vp_interp_hlsl);
+    if (n < 0 || (size_t)n + hl + 1 > sizeof s_vp_src) return NULL;
+    memcpy(s_vp_src + n, rsx_vp_interp_hlsl, hl + 1);
+    ID3DBlob* pb = NULL; ID3DBlob* err = NULL;
+    ULONGLONG t0 = GetTickCount64();
+    pb = interp_embedded_blob(16u + (unsigned)v, s_vp_src, (size_t)n + hl, "vs_5_0", vp_interp_opt());
+    HRESULT hr = pb ? S_OK : d3d_compile_cached(s_vp_src, (size_t)n + hl, "rsx_vp_interp", "vs_5_0",
+                                    vp_interp_opt(), &pb, &err);
+    s_vp_stat.compile_ms += (u32)(GetTickCount64() - t0);
+    if (FAILED(hr) || !pb) {
+        fprintf(stderr, "[interp-vp] compile fetch %d failed 0x%08lX %s\n", fetch, (unsigned long)hr,
+                err ? (const char*)err->lpVtbl->GetBufferPointer(err) : "");
+        if (err) err->lpVtbl->Release(err);
+        return NULL;
+    }
+    if (err) err->lpVtbl->Release(err);
+    s_vp_vs[v] = pb;
+    fprintf(stderr, "[interp-vp] vs %s: %u bytes\n", fetch ? "fetch" : "ia",
+            (unsigned)pb->lpVtbl->GetBufferSize(pb));
+    return pb;
+}
+
+static void vp_interp_make_root_sig(const D3D12_STATIC_SAMPLER_DESC* samp)
+{
+    if (!vp_interp_cfg() || !s_d3d.device || !samp) return;
+    D3D12_DESCRIPTOR_RANGE srv_range = {0};
+    srv_range.RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SRV;
+    srv_range.NumDescriptors = RSX_TEX_UNITS;
+    srv_range.BaseShaderRegister = 0;
+    srv_range.OffsetInDescriptorsFromTableStart = D3D12_DESCRIPTOR_RANGE_OFFSET_APPEND;
+
+    D3D12_ROOT_PARAMETER rp[7];
+    memset(rp, 0, sizeof rp);
+    rp[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_CBV;
+    rp[0].Descriptor.ShaderRegister = 0;
+    rp[0].ShaderVisibility = D3D12_SHADER_VISIBILITY_VERTEX;
+    rp[1].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+    rp[1].DescriptorTable.NumDescriptorRanges = 1;
+    rp[1].DescriptorTable.pDescriptorRanges = &srv_range;
+    rp[1].ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+    rp[2].ParameterType = D3D12_ROOT_PARAMETER_TYPE_CBV;
+    rp[2].Descriptor.ShaderRegister = 1;
+    rp[2].ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+    rp[3].ParameterType = D3D12_ROOT_PARAMETER_TYPE_SRV;
+    rp[3].Descriptor.ShaderRegister = 20;
+    rp[3].ShaderVisibility = D3D12_SHADER_VISIBILITY_VERTEX;
+    rp[4].ParameterType = D3D12_ROOT_PARAMETER_TYPE_CBV;
+    rp[4].Descriptor.ShaderRegister = 2;
+    rp[4].ShaderVisibility = D3D12_SHADER_VISIBILITY_VERTEX;
+    rp[5].ParameterType = D3D12_ROOT_PARAMETER_TYPE_SRV;
+    rp[5].Descriptor.ShaderRegister = 21;
+    rp[5].ShaderVisibility = D3D12_SHADER_VISIBILITY_VERTEX;
+    rp[6].ParameterType = D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS;
+    rp[6].Constants.ShaderRegister = 4;
+    rp[6].Constants.Num32BitValues = 4;
+    rp[6].ShaderVisibility = D3D12_SHADER_VISIBILITY_VERTEX;
+
+    D3D12_ROOT_SIGNATURE_DESC rd = {0};
+    rd.NumParameters = 7;
+    rd.pParameters = rp;
+    rd.NumStaticSamplers = RSX_TEX_UNITS;
+    rd.pStaticSamplers = samp;
+    rd.Flags = D3D12_ROOT_SIGNATURE_FLAG_ALLOW_INPUT_ASSEMBLER_INPUT_LAYOUT;
+    ID3DBlob* sig = NULL; ID3DBlob* err = NULL;
+    HRESULT hr = D3D12SerializeRootSignature(&rd, D3D_ROOT_SIGNATURE_VERSION_1, &sig, &err);
+    if (FAILED(hr)) {
+        fprintf(stderr, "[interp-vp] root signature serialize 0x%08lX %s\n", (unsigned long)hr,
+                err ? (const char*)err->lpVtbl->GetBufferPointer(err) : "");
+        if (err) err->lpVtbl->Release(err);
+        return;
+    }
+    hr = s_d3d.device->lpVtbl->CreateRootSignature(s_d3d.device, 0,
+        sig->lpVtbl->GetBufferPointer(sig), sig->lpVtbl->GetBufferSize(sig),
+        &IID_ID3D12RootSignature, (void**)&s_vp_rs);
+    sig->lpVtbl->Release(sig);
+    if (FAILED(hr)) fprintf(stderr, "[interp-vp] root signature create 0x%08lX\n", (unsigned long)hr);
+}
+
+static void vp_interp_startup(void)
+{
+    if (!vp_interp_cfg() || !s_d3d.device) return;
+    u32 kb = 1024;
+    const char* e = getenv("RSX_SHADER_INTERP_VP_ARENA_KB");
+    if (e && atoi(e) >= 256) kb = (u32)atoi(e);
+    if (kb > 16384u) kb = 16384u;
+    s_vp_arena_bytes = kb << 10;
+    D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_UPLOAD;
+    D3D12_RESOURCE_DESC bd = {0};
+    bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+    bd.Width = s_vp_arena_bytes;
+    bd.Height = 1; bd.DepthOrArraySize = 1; bd.MipLevels = 1;
+    bd.SampleDesc.Count = 1;
+    bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    D3D12_RANGE nr = {0, 0};
+    for (int p = 0; p < 2; p++) {
+        void* mapped = NULL;
+        if (SUCCEEDED(create_dyn_buffer(&hp, &bd, &s_vp_arena[p])) &&
+            SUCCEEDED(s_vp_arena[p]->lpVtbl->Map(s_vp_arena[p], 0, &nr, &mapped)))
+            s_vp_map[p] = (u8*)mapped;
+    }
+    ULONGLONG t0 = GetTickCount64();
+    vp_interp_blob(0);
+    vp_interp_blob(1);
+    fprintf(stderr, "[interp-vp] mode %d arena %u KB warmup %llu ms opt 0x%X\n",
+            vp_interp_cfg(), kb, (unsigned long long)(GetTickCount64() - t0), vp_interp_opt());
+}
+
+static void vp_interp_shutdown(void)
+{
+    vp_ps_hold_clear();
+    for (int i = 0; i < 2; i++)
+        if (s_vp_vs[i]) { s_vp_vs[i]->lpVtbl->Release(s_vp_vs[i]); s_vp_vs[i] = NULL; }
+    if (s_vp_rs) { s_vp_rs->lpVtbl->Release(s_vp_rs); s_vp_rs = NULL; }
+    for (int p = 0; p < 2; p++) {
+        if (s_vp_arena[p]) {
+            s_vp_arena[p]->lpVtbl->Unmap(s_vp_arena[p], 0, NULL);
+            s_vp_arena[p]->lpVtbl->Release(s_vp_arena[p]);
+            s_vp_arena[p] = NULL;
+        }
+        s_vp_map[p] = NULL;
+    }
+    for (LONG i = 0; i < s_vp_seen_n; i++) free(s_vp_seen[i].bytes);
+    s_vp_seen_n = 0;
+}
+
+static void vp_interp_log_tick(void)
+{
+    if (!vp_interp_cfg()) return;
+    static ULONGLONG last;
+    ULONGLONG now = GetTickCount64();
+    if (last && now - last < 5000) return;
+    last = now;
+    fprintf(stderr, "[interp-vp] draws %u fallback %u miss %u arena %u pso_fail %u seen %ld peak %uKB compile %ums\n",
+            s_vp_stat.draws, s_vp_stat.fallback, s_vp_stat.miss, s_vp_stat.arena,
+            s_interp_stat.pso_fail, (long)s_vp_seen_n, s_vp_stat.arena_peak >> 10, s_vp_stat.compile_ms);
+}
+
+static u32 vp_interp_alloc(int par, u32 bytes)
+{
+    u32 align = (s_vp_used[par] + 15u) & ~15u;
+    if (!s_vp_map[par] || align + bytes > s_vp_arena_bytes) return 0xFFFFFFFFu;
+    s_vp_used[par] = align + bytes;
+    if (s_vp_used[par] > s_vp_stat.arena_peak) s_vp_stat.arena_peak = s_vp_used[par];
+    return align;
+}
+
+/* Attributes the program reads, as the specialized GPU-fetch shader decides
+ * (rsx_vp_analyze_inputs); all sixteen when the analysis is not exact. */
+static u32 vp_interp_input_mask(const u8* bytes, u32 nbytes)
+{
+    extern int rsx_vp_analyze_inputs(const uint8_t*, u32, void*);
+    struct { u32 input_mask; int exact; } a;
+    a.input_mask = 0xFFFFu; a.exact = 0;
+    if (rsx_vp_analyze_inputs(bytes, nbytes, &a) < 0 || !a.exact) return 0xFFFFu;
+    return a.input_mask & 0xFFFFu;
+}
+
+/* Copy this draw's vertex program and a 64-byte header into the frame's
+ * arena. Returns 0 when the program was never recorded (the draw then keeps
+ * today's behaviour). The header and the offset it names live in the arena
+ * buffer, so one root SRV serves every draw. */
+static int vp_interp_stage(const D3D12DrawRecord* dr, u32* hdr_off)
+{
+    if (!vp_interp_mode() || !dr || !dr->is_vp || !hdr_off) return 0;
+    if (s_device_lost || !s_vp_rs) return 0;
+    const u8* bytes = NULL; u32 nbytes = 0, base = 0;
+    if (!dr->vp_hash || !vp_interp_find(dr->vp_hash, &bytes, &nbytes, &base)) { s_vp_stat.miss++; return 0; }
+    int par = FR->parity & 1;
+    if (!s_vp_map[par]) return 0;
+    if (s_vp_tag[par] != s_d3d.frame_count) {
+        s_vp_tag[par] = s_d3d.frame_count;
+        s_vp_used[par] = 0;
+        s_vp_up_n[par] = 0;
+    }
+    u32 ioff = 0xFFFFFFFFu;
+    for (u32 i = 0; i < s_vp_up_n[par]; i++)
+        if (s_vp_up[par][i].hash == dr->vp_hash && s_vp_up[par][i].nbytes == nbytes) {
+            ioff = s_vp_up[par][i].off;
+            break;
+        }
+    if (ioff == 0xFFFFFFFFu) {
+        ioff = vp_interp_alloc(par, nbytes);
+        if (ioff == 0xFFFFFFFFu) { s_vp_stat.arena++; return 0; }
+        memcpy(s_vp_map[par] + ioff, bytes, nbytes);
+        if (s_vp_up_n[par] < 1024) {
+            VpUp* slot = &s_vp_up[par][s_vp_up_n[par]++];
+            slot->hash = dr->vp_hash; slot->off = ioff; slot->nbytes = nbytes;
+        }
+    }
+    u32 hoff = vp_interp_alloc(par, 64u);
+    if (hoff == 0xFFFFFFFFu) { s_vp_stat.arena++; return 0; }
+    u32 hdr[16];
+    memset(hdr, 0, sizeof hdr);
+    hdr[0] = ioff;
+    hdr[1] = nbytes / 16u;
+    hdr[2] = vp_interp_base_rel() ? base : 0u;
+    hdr[3] = 0; /* branch bits: the D3D12 path never sets them (rsx_vp_set_branch_bits) */
+    hdr[4] = vp_interp_uw() ? 1u : 0u;
+    hdr[5] = vp_interp_input_mask(bytes, nbytes);
+    memcpy(s_vp_map[par] + hoff, hdr, sizeof hdr);
+    *hdr_off = hoff;
+    return 1;
+}
+
+/* Vertex interpreter with the draw's specialized pixel shader (ps). */
+static ID3D12PipelineState* vp_interp_pso(const D3D12DrawRecord* dr, u32 draw_i, int nrt, DXGI_FORMAT rtfmt,
+    u32 blend, u32 cmask, u32 cull, u32 cube_mask, u32 stencil, ID3DBlob* ps)
+{
+    /* Slot generation is authoritative; reused CPU draw records may carry
+     * a stale gpu_fetch byte from an earlier indexed draw. */
+    int gpu = gf_slot(draw_i) ? 1 : 0;
+    ID3D12PipelineState* pso = interp_get_pso(2, vp_interp_blob(gpu), ps, gpu, s_pso_vmask, nrt, rtfmt,
+                                              blend, cmask, cull, cube_mask, stencil);
+    return pso;
+}
+
+/* on_fp_sig: the draw uses the fragment interpreter's signature, which carries
+ * the vertex interpreter's program and header as parameters 7 and 8. */
+static void vp_interp_bind(u32 hdr_off, int on_fp_sig)
+{
+    int par = FR->parity & 1;
+    if (!s_vp_arena[par] || !s_d3d.cmd_list) return;
+    s_d3d.cmd_list->lpVtbl->SetGraphicsRootShaderResourceView(s_d3d.cmd_list, on_fp_sig ? 7u : 5u,
+        s_vp_arena[par]->lpVtbl->GetGPUVirtualAddress(s_vp_arena[par]));
+    UINT c[4] = { hdr_off, 0, 0, 0 };
+    s_d3d.cmd_list->lpVtbl->SetGraphicsRoot32BitConstants(s_d3d.cmd_list, on_fp_sig ? 8u : 6u, 4, c, 0);
+}
diff --git a/libs/video/rsx_vp_interp_hlsl.inc b/libs/video/rsx_vp_interp_hlsl.inc
new file mode 100644
index 0000000..8a7ce20
--- /dev/null
+++ b/libs/video/rsx_vp_interp_hlsl.inc
@@ -0,0 +1,318 @@
+static const char rsx_vp_interp_hlsl[] =
+"// RSX vertex interpreter, vs_5_0. Semantics follow rsx_vp_decompiler.c in this\n"
+"// tree (NV40 co-issued vector + scalar). No RPCS3 source. RSX_VP_INTERP_FETCH\n"
+"// 1 reads attributes from t20/b2; 0 reads ATTR0..15. The program is the raw\n"
+"// little-endian words at t21. TXL is 0, matching the D3D12 decompile calls,\n"
+"// which pass a zero vertex-texture mask.\n"
+"\n"
+"#ifndef RSX_VP_INTERP_FETCH\n"
+"#define RSX_VP_INTERP_FETCH 1\n"
+"#endif\n"
+"#ifndef RSX_VP_INTERP_STEPS\n"
+"#define RSX_VP_INTERP_STEPS 4096\n"
+"#endif\n"
+"\n"
+"cbuffer VPConst : register(b0) {\n"
+"    float4 vp_c[512];\n"
+"    float4 vp_posscale;\n"
+"    float4 vp_posoffset;\n"
+"};\n"
+"ByteAddressBuffer rsx_vprog : register(t21);\n"
+"cbuffer RSXVPInterp : register(b4) {\n"
+"    uint vp_hdr;\n"
+"    uint vp_pad1;\n"
+"    uint vp_pad2;\n"
+"    uint vp_pad3;\n"
+"};\n"
+"\n"
+"#if RSX_VP_INTERP_FETCH\n"
+"ByteAddressBuffer rsx_vraw : register(t20);\n"
+"cbuffer VFetch : register(b2) { uint4 vf_desc[16]; float4 vf_def[16]; };\n"
+"uint vf_le32(uint a) {\n"
+"    uint al = a & ~3u; uint sh = (a & 3u) * 8u;\n"
+"    uint w0 = rsx_vraw.Load(al);\n"
+"    if (sh == 0u) return w0;\n"
+"    return (w0 >> sh) | (rsx_vraw.Load(al + 4u) << (32u - sh));\n"
+"}\n"
+"uint vf_be32(uint a) { uint w = vf_le32(a);\n"
+"    return (w >> 24) | ((w >> 8) & 0xFF00u) | ((w << 8) & 0xFF0000u) | (w << 24); }\n"
+"uint vf_be16(uint a) { uint w = vf_le32(a); return ((w & 0xFFu) << 8) | ((w >> 8) & 0xFFu); }\n"
+"uint vf_u8(uint a) { return vf_le32(a) & 0xFFu; }\n"
+"float vf_half(uint h) {\n"
+"    uint sg = (h >> 15) & 1u, e = (h >> 10) & 0x1Fu, m = h & 0x3FFu; uint f;\n"
+"    if (e == 0u) f = sg << 31;\n"
+"    else if (e == 31u) f = (sg << 31) | 0x7F800000u | (m << 13);\n"
+"    else f = (sg << 31) | ((e + 112u) << 23) | (m << 13);\n"
+"    return asfloat(f);\n"
+"}\n"
+"float4 rsx_vfetch(uint k, uint vid) {\n"
+"    float4 r = vf_def[k];\n"
+"    uint4 d = vf_desc[k];\n"
+"    if ((d.z & 0x100u) == 0u) return r;\n"
+"    uint ty = d.z & 0xFu, n = (d.z >> 4) & 7u;\n"
+"    uint a = d.x + vid * d.y;\n"
+"    float c0 = r.x, c1 = r.y, c2 = r.z, c3 = r.w;\n"
+"    if (ty == 6u) {\n"
+"        uint w = vf_be32(a);\n"
+"        int x = int(w & 0x7FFu), y = int((w >> 11) & 0x7FFu), z = int((w >> 22) & 0x3FFu);\n"
+"        if (x & 0x400) x -= 0x800;\n"
+"        if (y & 0x400) y -= 0x800;\n"
+"        if (z & 0x200) z -= 0x400;\n"
+"        c0 = float(x) / 1023.0; c1 = float(y) / 1023.0; c2 = float(z) / 511.0;\n"
+"    } else {\n"
+"        [unroll] for (uint i = 0; i < 4u; i++) {\n"
+"            if (i < n) {\n"
+"                float v;\n"
+"                if (ty == 3u)      v = vf_half(vf_be16(a + 2u * i));\n"
+"                else if (ty == 4u) v = float(vf_u8(a + i)) / 255.0;\n"
+"                else if (ty == 1u) v = float(int(vf_be16(a + 2u * i) << 16) >> 16) / 32767.0;\n"
+"                else if (ty == 5u) v = float(int(vf_be16(a + 2u * i) << 16) >> 16);\n"
+"                else if (ty == 7u) v = float(vf_u8(a + i));\n"
+"                else               v = asfloat(vf_be32(a + 4u * i));\n"
+"                if (i == 0u) c0 = v; else if (i == 1u) c1 = v; else if (i == 2u) c2 = v; else c3 = v;\n"
+"            }\n"
+"        }\n"
+"    }\n"
+"    return float4(c0, c1, c2, c3);\n"
+"}\n"
+"struct VSInput { uint vid : SV_VertexID; };\n"
+"#else\n"
+"struct VSInput {\n"
+"    float4 a0:ATTR0;  float4 a1:ATTR1;  float4 a2:ATTR2;  float4 a3:ATTR3;\n"
+"    float4 a4:ATTR4;  float4 a5:ATTR5;  float4 a6:ATTR6;  float4 a7:ATTR7;\n"
+"    float4 a8:ATTR8;  float4 a9:ATTR9;  float4 a10:ATTR10; float4 a11:ATTR11;\n"
+"    float4 a12:ATTR12; float4 a13:ATTR13; float4 a14:ATTR14; float4 a15:ATTR15;\n"
+"};\n"
+"#endif\n"
+"\n"
+"struct VSOutput {\n"
+"    float4 pos:SV_Position; float4 col0:COLOR0; float4 col1:COLOR1;\n"
+"    float4 fog:FOG;\n"
+"    float4 t0:TEXCOORD0; float4 t1:TEXCOORD1; float4 t2:TEXCOORD2; float4 t3:TEXCOORD3;\n"
+"    float4 t4:TEXCOORD4; float4 t5:TEXCOORD5; float4 t6:TEXCOORD6; float4 t7:TEXCOORD7;\n"
+"    float4 t8:TEXCOORD8; float4 t9:TEXCOORD9;\n"
+"};\n"
+"\n"
+"float vp_mul1(float a, float b) { return (a == 0.0 || b == 0.0) ? 0.0 : a * b; }\n"
+"float4 vp_mul(float4 a, float4 b) {\n"
+"    return float4(vp_mul1(a.x, b.x), vp_mul1(a.y, b.y), vp_mul1(a.z, b.z), vp_mul1(a.w, b.w));\n"
+"}\n"
+"float vp_dot3(float4 a, float4 b) { float4 m = vp_mul(a, b); return m.x + m.y + m.z; }\n"
+"float vp_dot4(float4 a, float4 b) { float4 m = vp_mul(a, b); return m.x + m.y + m.z + m.w; }\n"
+"\n"
+"float4 vp_swiz(float4 b, uint src) {\n"
+"    uint sw = (src >> 8) & 3u, sz = (src >> 10) & 3u, sy = (src >> 12) & 3u, sx = (src >> 14) & 3u;\n"
+"    return float4(b[sx], b[sy], b[sz], b[sw]);\n"
+"}\n"
+"\n"
+"int vp_addr(int4 a0, int4 a1, uint sel, uint sw) {\n"
+"    int4 a = sel != 0u ? a1 : a0;\n"
+"    return sw == 0u ? a.x : sw == 1u ? a.y : sw == 2u ? a.z : a.w;\n"
+"}\n"
+"\n"
+"bool vp_cc_pass(float cv, uint cond) {\n"
+"    if (cond == 1u) return cv < 0.0;\n"
+"    if (cond == 2u) return cv == 0.0;\n"
+"    if (cond == 3u) return cv <= 0.0;\n"
+"    if (cond == 4u) return cv > 0.0;\n"
+"    if (cond == 5u) return cv != 0.0;\n"
+"    if (cond == 6u) return cv >= 0.0;\n"
+"    if (cond == 7u) return true;\n"
+"    return false;\n"
+"}\n"
+"\n"
+"// One 17-bit source operand: register file, swizzle, then absolute, then negate.\n"
+"// A macro, not a function, so v[] and r[] are not copied per call.\n"
+"#define VP_SRC(DST, SRC, ABSBIT) { \\\n"
+"    uint _s = (SRC); uint _ty = _s & 3u; float4 _b = (float4)0; \\\n"
+"    if (_ty == 2u) _b = v[input_src & 15u]; \\\n"
+"    else if (_ty == 3u) { \\\n"
+"        uint _ix = const_src & 511u; \\\n"
+"        if (index_const != 0u) _ix = (uint)((int)const_src + vp_addr(a0, a1, addr_sel, addr_swz)) & 511u; \\\n"
+"        _b = vp_c[_ix]; \\\n"
+"    } else _b = r[(_s >> 2) & 31u]; \\\n"
+"    _b = vp_swiz(_b, _s); \\\n"
+"    if ((ABSBIT) != 0u) _b = abs(_b); \\\n"
+"    if (((_s >> 16) & 1u) != 0u) _b = -_b; \\\n"
+"    DST = _b; }\n"
+"\n"
+"VSOutput main(VSInput input) {\n"
+"    float4 v[16];\n"
+"    float4 r[32];\n"
+"    float4 o[16];\n"
+"    float4 cc[2];\n"
+"    int4 a0 = (int4)0;\n"
+"    int4 a1 = (int4)0;\n"
+"    [unroll] for (int i = 0; i < 16; i++) { v[i] = float4(0, 0, 0, 1); o[i] = float4(0, 0, 0, 1); }\n"
+"    [unroll] for (int j = 0; j < 32; j++) r[j] = (float4)0;\n"
+"    cc[0] = (float4)0; cc[1] = (float4)0;\n"
+"    uint h = vp_hdr;\n"
+"#if RSX_VP_INTERP_FETCH\n"
+"    // Only the attributes the program reads, as the specialized fetch shader does. One loop,\n"
+"    // so the fetch code is emitted once rather than sixteen times.\n"
+"    uint imask = rsx_vprog.Load(h + 20u);\n"
+"    [loop] for (uint k = 0; k < 16u; k++) if (((imask >> k) & 1u) != 0u) v[k] = rsx_vfetch(k, input.vid);\n"
+"#else\n"
+"    v[0]=input.a0; v[1]=input.a1; v[2]=input.a2; v[3]=input.a3;\n"
+"    v[4]=input.a4; v[5]=input.a5; v[6]=input.a6; v[7]=input.a7;\n"
+"    v[8]=input.a8; v[9]=input.a9; v[10]=input.a10; v[11]=input.a11;\n"
+"    v[12]=input.a12; v[13]=input.a13; v[14]=input.a14; v[15]=input.a15;\n"
+"#endif\n"
+"    uint ioff = rsx_vprog.Load(h);\n"
+"    uint count = rsx_vprog.Load(h + 4u);\n"
+"    uint base = rsx_vprog.Load(h + 8u);\n"
+"    uint bits = rsx_vprog.Load(h + 12u);\n"
+"    uint flags = rsx_vprog.Load(h + 16u);\n"
+"    int pc = 0;\n"
+"    int cs[8];\n"
+"    int csp = 0;\n"
+"    [unroll] for (int s = 0; s < 8; s++) cs[s] = 0;\n"
+"    [loop] for (int it = 0; it < RSX_VP_INTERP_STEPS && pc >= 0 && (uint)pc < count; it++) {\n"
+"        uint at = ioff + (uint)pc * 16u;\n"
+"        uint d0 = rsx_vprog.Load(at);\n"
+"        uint d1 = rsx_vprog.Load(at + 4u);\n"
+"        uint d2 = rsx_vprog.Load(at + 8u);\n"
+"        uint d3 = rsx_vprog.Load(at + 12u);\n"
+"        uint vec_op = (d1 >> 22) & 0x1Fu;\n"
+"        uint sca_op = (d1 >> 27) & 0x1Fu;\n"
+"        uint input_src = (d1 >> 8) & 0xFu;\n"
+"        uint const_src = (d1 >> 12) & 0x3FFu;\n"
+"        uint index_const = (d3 >> 1) & 1u;\n"
+"        uint src0 = ((d2 >> 23) & 0x1FFu) | ((d1 & 0xFFu) << 9);\n"
+"        uint src1 = (d2 >> 6) & 0x1FFFFu;\n"
+"        uint src2 = ((d3 >> 21) & 0x7FFu) | ((d2 & 0x3Fu) << 11);\n"
+"        uint dst_tmp = (d0 >> 15) & 0x3Fu;\n"
+"        uint dst_out = (d3 >> 2) & 0x1Fu;\n"
+"        uint sca_dst_tmp = (d3 >> 7) & 0x3Fu;\n"
+"        uint vec_result = (d0 >> 30) & 1u;\n"
+"        uint vmask = ((d3 >> 16) & 1u) | (((d3 >> 15) & 1u) << 1) | (((d3 >> 14) & 1u) << 2) | (((d3 >> 13) & 1u) << 3);\n"
+"        uint smask = ((d3 >> 20) & 1u) | (((d3 >> 19) & 1u) << 1) | (((d3 >> 18) & 1u) << 2) | (((d3 >> 17) & 1u) << 3);\n"
+"        uint cond = (d0 >> 10) & 7u;\n"
+"        uint cond_test = (d0 >> 13) & 1u;\n"
+"        uint csel = (d0 >> 25) & 1u;\n"
+"        uint cswx = (d0 >> 8) & 3u, cswy = (d0 >> 6) & 3u, cswz = (d0 >> 4) & 3u, csww = (d0 >> 2) & 3u;\n"
+"        uint4 csw = uint4(cswx, cswy, cswz, csww);\n"
+"        int predicated = (cond_test != 0u && cond != 7u) ? 1 : 0;\n"
+"        uint sat_bit = (d0 >> 26) & 1u;\n"
+"        uint addr_sel = (d0 >> 24) & 1u;\n"
+"        uint addr_swz = d0 & 3u;\n"
+"        float4 A, B, C;\n"
+"        VP_SRC(A, src0, (d0 >> 21) & 1u)\n"
+"        VP_SRC(B, src1, (d0 >> 22) & 1u)\n"
+"        VP_SRC(C, src2, (d0 >> 23) & 1u)\n"
+"        int branched = 0;\n"
+"        int next = pc + 1;\n"
+"        if (vmask != 0u && vec_op != 0u) {\n"
+"            if (vec_op == 0x0Du) {\n"
+"                int4 ar = (int4)floor(A);\n"
+"                [unroll] for (uint c = 0u; c < 4u; c++) if (vmask & (1u << c)) {\n"
+"                    if (addr_sel != 0u) a1[c] = ar[c]; else a0[c] = ar[c];\n"
+"                }\n"
+"            } else if (vec_op <= 0x16u || vec_op == 0x19u) {\n"
+"                float4 val = (float4)0;\n"
+"                if (vec_op == 0x01u) val = A;\n"
+"                else if (vec_op == 0x02u) val = vp_mul(A, B);\n"
+"                else if (vec_op == 0x03u) val = A + C;\n"
+"                else if (vec_op == 0x04u) val = vp_mul(A, B) + C;\n"
+"                else if (vec_op == 0x05u) val = (float4)vp_dot3(A, B);\n"
+"                else if (vec_op == 0x06u) val = (float4)(vp_dot3(A, B) + B.w);\n"
+"                else if (vec_op == 0x07u) val = (float4)vp_dot4(A, B);\n"
+"                else if (vec_op == 0x08u) val = float4(1, A.y * B.y, A.z, B.w);\n"
+"                else if (vec_op == 0x09u) val = min(A, B);\n"
+"                else if (vec_op == 0x0Au) val = max(A, B);\n"
+"                else if (vec_op == 0x0Bu) val = float4(A.x < B.x, A.y < B.y, A.z < B.z, A.w < B.w);\n"
+"                else if (vec_op == 0x0Cu) val = float4(A.x >= B.x, A.y >= B.y, A.z >= B.z, A.w >= B.w);\n"
+"                else if (vec_op == 0x0Eu) val = frac(A);\n"
+"                else if (vec_op == 0x0Fu) val = floor(A);\n"
+"                else if (vec_op == 0x10u) val = float4(A.x == B.x, A.y == B.y, A.z == B.z, A.w == B.w);\n"
+"                else if (vec_op == 0x11u) val = (float4)0;\n"
+"                else if (vec_op == 0x12u) val = float4(A.x > B.x, A.y > B.y, A.z > B.z, A.w > B.w);\n"
+"                else if (vec_op == 0x13u) val = float4(A.x <= B.x, A.y <= B.y, A.z <= B.z, A.w <= B.w);\n"
+"                else if (vec_op == 0x14u) val = float4(A.x != B.x, A.y != B.y, A.z != B.z, A.w != B.w);\n"
+"                else if (vec_op == 0x15u) val = float4(1, 1, 1, 1);\n"
+"                else if (vec_op == 0x16u) val = sign(A);\n"
+"                else val = (float4)0;\n"
+"                if (sat_bit) val = saturate(val);\n"
+"                uint cc_update = ((d0 >> 14) & 1u) && ((d0 >> 29) & 1u);\n"
+"                bool ok[4];\n"
+"                [unroll] for (uint c = 0u; c < 4u; c++)\n"
+"                    ok[c] = predicated == 0 || vp_cc_pass(cc[csel][csw[c]], cond);\n"
+"                [unroll] for (uint c = 0u; c < 4u; c++) if ((vmask & (1u << c)) != 0u && ok[c]) {\n"
+"                    if (vec_result != 0u && dst_out != 0x1Fu) o[dst_out & 15u][c] = val[c];\n"
