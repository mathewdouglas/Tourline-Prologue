diff --git a/libs/video/rsx_fp_interp.h b/libs/video/rsx_fp_interp.h
new file mode 100644
index 0000000..6011b6f
--- /dev/null
+++ b/libs/video/rsx_fp_interp.h
@@ -0,0 +1,445 @@
+/*
+ * RSX fragment-program image for the ps_5_1 interpreter.
+ *
+ * The image is original. Bit fields follow rsx_fp_decompiler.c (the NV40
+ * encoding that translator already accepts). One 16-byte word per instruction,
+ * constant payloads omitted; those stay in b1 fp_constants[] in program order.
+ *
+ * u0: opcode 6 | dest 6 | half | nowrite | mask 4 | sat | scale 3 | pred 2 |
+ *     cmp 3 | cc_read | setcond | cc_write | persp | FLOW
+ * ALU: u1 = src0 22 | input_src 4 | tex 4 | bx2
+ *      u2 = src1 22 | cond swizzle 8
+ *      u3 = src2 22 | const slot 8
+ * FLOW: u1 = else_pc 16 | end_pc 16 (else 0xFFFF = none)
+ *       u2 = init 8 | end_n 8 | step 8
+ *       u3 = cond swizzle 8
+ * src 22: type 2 | index 6 | half | neg | abs | prec 3 | swizzle 8
+ *         (swizzle x selector in the low 2 bits)
+ *
+ * Diagnostic env RSX_FP_SAT_PROG / RSX_FP_SAT_OPS / RSX_FP_SAT_VIS are not
+ * read. RSX_FP_SOURCE_RANGE is, with the same default as the decompiler (2).
+ */
+#ifndef PS3RECOMP_RSX_FP_INTERP_H
+#define PS3RECOMP_RSX_FP_INTERP_H
+
+#include "rsx_fp_decompiler.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define RSX_FP_INTERP_MAX_INSNS 512u
+#define RSX_FP_INTERP_MAX_CONST 256u
+#define RSX_FP_INTERP_MAX_NEST  8u
+
+#define RSX_FP_INTERP_BAD_ARGS       1u
+#define RSX_FP_INTERP_UNTERMINATED   2u
+#define RSX_FP_INTERP_TOO_LONG       4u
+#define RSX_FP_INTERP_TOO_MANY_CONST 8u
+#define RSX_FP_INTERP_NESTING        16u
+#define RSX_FP_INTERP_OVERFLOW       32u
+#define RSX_FP_INTERP_TEMP           64u
+
+typedef struct rsx_fp_interp_info {
+    u32 status;
+    u32 instructions;
+    u32 constants;
+    u32 wrote_r;
+    u32 wrote_h;
+    u32 half;
+    u32 targets;
+    u32 depth_export;
+    u32 max_nest;
+    u32 branches;
+    u32 textured;
+    u32 predicated;
+} rsx_fp_interp_info;
+
+/* dst receives 4 uints per instruction. dst may be NULL to only classify.
+ * Returns 0 when status is clear. */
+int rsx_fp_interp_encode(const u8* ucode, u32 max_bytes, u32 ctrl,
+                         u32* dst, u32 dst_words, rsx_fp_interp_info* info);
+
+#ifdef __cplusplus
+}
+#endif
+
+/* Prefix shared by the engine and scripts/test/fp_interp_precompile.c.
+ * targets == 1 is the single-output entry (no MRT define). The bytes are part
+ * of the DXBC cache key, so both callers must use this function. */
+static int rsx_fp_interp_variant_prefix(char* dst, unsigned cap, int fullin, int sample, int targets)
+{
+    int n;
+    if (!dst || cap < 8u) return -1;
+    if (targets < 1) targets = 1;
+    if (targets > 4) targets = 4;
+    if (targets == 1)
+        n = snprintf(dst, cap, "#define RSX_INTERP_FULLIN %d\n#define RSX_INTERP_SAMPLE %d\n",
+                     fullin ? 1 : 0, sample ? 1 : 0);
+    else
+        n = snprintf(dst, cap,
+                     "#define RSX_INTERP_FULLIN %d\n#define RSX_INTERP_SAMPLE %d\n"
+                     "#define RSX_INTERP_MRT 1\n#define RSX_INTERP_TARGETS %d\n",
+                     fullin ? 1 : 0, sample ? 1 : 0, targets);
+    if (n < 0 || (unsigned)n >= cap) return -1;
+    return n;
+}
+
+#ifdef RSX_FP_INTERP_EMBED_HLSL
+#include "rsx_fp_interp_hlsl.inc"
+#endif
+
+#endif
+
+#if defined(RSX_FP_INTERP_IMPLEMENTATION) && !defined(RSX_FP_INTERP_IMPLEMENTED)
+#define RSX_FP_INTERP_IMPLEMENTED
+
+#include <stdlib.h>
+#include <string.h>
+
+static int rsx_fp_interp_range_mode(void)
+{
+    const char* e = getenv("RSX_FP_SOURCE_RANGE");
+    if (!e || e[0] == '\0' || e[0] == '2') return 2;
+    if (e[0] == '0') return 0;
+    if (e[0] == '1') return 1;
+    if (e[0] == '3') return 3;
+    return 2;
+}
+
+static int rsx_fp_interp_handled(u32 op)
+{
+    switch (op) {
+    case 0x01: case 0x02: case 0x03: case 0x04: case 0x05: case 0x06:
+    case 0x08: case 0x09: case 0x0A: case 0x0B: case 0x0C: case 0x0D:
+    case 0x0E: case 0x0F: case 0x10: case 0x11: case 0x13: case 0x14:
+    case 0x17: case 0x18: case 0x1A: case 0x1B: case 0x1C: case 0x1D:
+    case 0x1F: case 0x22: case 0x23: case 0x24: case 0x25: case 0x26:
+    case 0x27: case 0x28: case 0x29: case 0x2A: case 0x2C: case 0x2D:
+    case 0x2F: case 0x31: case 0x38: case 0x39: case 0x3A: case 0x3B:
+    case 0x3C:
+        return 1;
+    default:
+        return 0;
+    }
+}
+
+static int rsx_fp_interp_src_used(u32 op, int slot)
+{
+    switch (op) {
+    case 0x01: case 0x10: case 0x11: case 0x13: case 0x14:
+    case 0x17: case 0x18:
+    case 0x1A: case 0x1B: case 0x1C: case 0x1D:
+    case 0x22: case 0x23: case 0x24: case 0x25:
+    case 0x27: case 0x28: case 0x29: case 0x2A:
+    case 0x2C: case 0x2D: case 0x39: case 0x3C:
+        return slot == 0;
+    case 0x2F: case 0x31:
+        return slot == 0 || slot == 1;
+    case 0x02: case 0x03: case 0x05: case 0x06: case 0x08: case 0x09:
+    case 0x0A: case 0x0B: case 0x0C: case 0x0D: case 0x0E: case 0x0F:
+    case 0x26: case 0x38: case 0x3A: case 0x3B:
+        return slot <= 1;
+    case 0x04: case 0x1F:
+        return 1;
+    default:
+        return 0;
+    }
+}
+
+static int rsx_fp_interp_is_fetch(u32 op)
+{
+    return op == 0x17 || op == 0x18 || op == 0x19 || op == 0x2F || op == 0x31;
+}
+
+static int rsx_fp_interp_export_target(u32 index, int half)
+{
+    static const u32 reg[2][4] = {{0, 2, 3, 4}, {0, 4, 6, 8}};
+    int t;
+    for (t = 0; t < 4; t++)
+        if (reg[half][t] == index) return t;
+    return -1;
+}
+
+static u32 rsx_fp_interp_pack_src(u32 w, int absbit, u32 prec)
+{
+    u32 type = w & 3u;
+    u32 index = (w >> 2) & 63u;
+    u32 half = (w >> 8) & 1u;
+    u32 neg = (w >> 17) & 1u;
+    u32 sw = (w >> 9) & 255u;
+    return type | (index << 2) | (half << 8) | (neg << 9) |
+           ((absbit ? 1u : 0u) << 10) | ((prec & 7u) << 11) | (sw << 14);
+}
+
+static u32 rsx_fp_interp_map_pc(const u32* inst_off, u32 ninst, u32 byte_off)
+{
+    u32 i;
+    for (i = 0; i < ninst; i++)
+        if (inst_off[i] == byte_off) return i;
+    return ninst;
+}
+
+static u32 rsx_fp_interp_cmp(int lt, int eq, int gr)
+{
+    if (gr && eq) return 1u;
+    if (lt && eq) return 2u;
+    if (gr && lt) return 3u;
+    if (gr) return 4u;
+    if (lt) return 5u;
+    return 0u;
+}
+
+int rsx_fp_interp_encode(const u8* ucode, u32 max_bytes, u32 ctrl,
+                         u32* dst, u32 dst_words, rsx_fp_interp_info* info)
+{
+    u32 inst_off[RSX_FP_INTERP_MAX_INSNS];
+    u32 end_stack[32];
+    u32 ninst = 0, nconst = 0, off = 0, max_nest = 0, status = 0;
+    int sp = 0, saw_end = 0;
+    u32 wrote_r = 0, wrote_h = 0, branches = 0, textured = 0, predicated = 0;
+    int range;
+    u32 i;
+
+    if (info) memset(info, 0, sizeof *info);
+    if (!ucode || !info || (dst == NULL && dst_words != 0))
+        return (int)RSX_FP_INTERP_BAD_ARGS;
+    if (!ucode || max_bytes < 16) {
+        if (info) info->status = RSX_FP_INTERP_BAD_ARGS;
+        return (int)RSX_FP_INTERP_BAD_ARGS;
+    }
+
+    while (off + 16 <= max_bytes) {
+        u32 w0, w1, w2, w3, start, op, end_at;
+        if (ninst >= RSX_FP_INTERP_MAX_INSNS) {
+            status |= RSX_FP_INTERP_TOO_LONG;
+            break;
+        }
+        w0 = rsx_fp_read_word(ucode + off);
+        w1 = rsx_fp_read_word(ucode + off + 4);
+        w2 = rsx_fp_read_word(ucode + off + 8);
+        w3 = rsx_fp_read_word(ucode + off + 12);
+        start = off;
+        off += 16;
+        if (((w1 & 3u) == 2u) || ((w2 & 3u) == 2u) || ((w3 & 3u) == 2u)) {
+            if (off + 16 > max_bytes) {
+                status |= RSX_FP_INTERP_UNTERMINATED;
+                break;
+            }
+            off += 16;
+            nconst++;
+        }
+        while (sp > 0 && end_stack[sp - 1] == start) sp--;
+        inst_off[ninst++] = start;
+        op = (w0 >> 24) & 63u;
+        if (w2 & 0x80000000u) {
+            if (op == 0x02u || op == 0x03u || op == 0x04u) {
+                end_at = (w3 & 0x7fffffffu) << 2;
+                if (sp < 32 && end_at > off) {
+                    if (sp >= (int)RSX_FP_INTERP_MAX_NEST)
+                        status |= RSX_FP_INTERP_NESTING;
+                    end_stack[sp++] = end_at;
+                    if ((u32)sp > max_nest) max_nest = (u32)sp;
+                }
+            }
+        }
+        if (w0 & 1u) {
+            saw_end = 1;
+            break;
+        }
+    }
+    if (!saw_end) status |= RSX_FP_INTERP_UNTERMINATED;
+    if (status & RSX_FP_INTERP_TOO_LONG) status &= ~RSX_FP_INTERP_UNTERMINATED;
+    if (nconst > RSX_FP_INTERP_MAX_CONST) status |= RSX_FP_INTERP_TOO_MANY_CONST;
+    if (dst && dst_words < ninst * 4u) status |= RSX_FP_INTERP_OVERFLOW;
+
+    range = rsx_fp_interp_range_mode();
+    off = 0;
+    nconst = 0;
+    for (i = 0; i < ninst; i++) {
+        u32 w0 = rsx_fp_read_word(ucode + inst_off[i]);
+        u32 w1 = rsx_fp_read_word(ucode + inst_off[i] + 4);
+        u32 w2 = rsx_fp_read_word(ucode + inst_off[i] + 8);
+        u32 w3 = rsx_fp_read_word(ucode + inst_off[i] + 12);
+        u32 opcode = (w0 >> 24) & 63u;
+        u32 input_src = (w0 >> 13) & 15u;
+        u32 tex_unit = (w0 >> 17) & 15u;
+        int is_branch = (w2 & 0x80000000u) != 0;
+        int lt = (w1 & (1u << 18)) != 0;
+        int eq = (w1 & (1u << 19)) != 0;
+        int gr = (w1 & (1u << 20)) != 0;
+        int is_uncond = lt && eq && gr;
+        int is_never = !lt && !eq && !gr;
+        u32 pred = is_uncond ? 0u : is_never ? 1u : 2u;
+        u32 cmp = rsx_fp_interp_cmp(lt, eq, gr);
+        u32 cswz = (w1 >> 21) & 255u;
+        u32 cc_read = (w1 >> 31) & 1u;
+        u32 cc_write = (w1 >> 30) & 1u;
+        u32 setcond = (w0 >> 8) & 1u;
+        u32 has_const = ((w1 & 3u) == 2u) || ((w2 & 3u) == 2u) || ((w3 & 3u) == 2u);
+        u32 kslot = nconst;
+        u32 after = inst_off[i] + 16u + (has_const ? 16u : 0u);
+        u32 mask = (w0 >> 9) & 15u;
+        u32 u0, u1 = 0, u2 = 0, u3 = 0;
+        u32 prec[3];
+        u32 s0, s1, s2;
+        int slot;
+        int flow = 0;
+        int handled = !is_branch && rsx_fp_interp_handled(opcode);
+        int has_dest = (w0 & (1u << 30)) == 0;
+        if (mask == 0) mask = 15u;
+        if (has_const) nconst++;
+
+        prec[0] = (w2 >> 19) & 7u;
+        prec[1] = (w2 >> 22) & 7u;
+        prec[2] = (w2 >> 25) & 7u;
+        for (slot = 0; slot < 3; slot++) {
+            u32 word = slot == 0 ? w1 : slot == 1 ? w2 : w3;
+            u32 type = word & 3u;
+            if (!range || (range >= 2 && prec[slot] != 4u) || type == 1u ||
+                (range == 3 && rsx_fp_interp_is_fetch(opcode)))
+                prec[slot] = 0;
+        }
+        s0 = rsx_fp_interp_pack_src(w1, (w1 & (1u << 29)) != 0, prec[0]);
+        s1 = rsx_fp_interp_pack_src(w2, (w2 & (1u << 18)) != 0, prec[1]);
+        s2 = rsx_fp_interp_pack_src(w3, 0, prec[2]);
+
+        if (!is_branch && handled && has_dest) {
+            u32 dst_idx = (w0 >> 1) & 63u;
+            int dst_half = (w0 & (1u << 7)) != 0;
+            int target = rsx_fp_interp_export_target(dst_idx, dst_half);
+            if (target >= 0) {
+                if (dst_half) wrote_h |= 1u << target;
+                else wrote_r |= 1u << target;
+            }
+        }
+        if (!is_branch) {
+            u32 words[3] = {w1, w2, w3};
+            int absb[3] = {(w1 & (1u << 29)) != 0, (w2 & (1u << 18)) != 0, 0};
+            for (slot = 0; slot < 3; slot++) {
+                u32 type = words[slot] & 3u;
+                u32 index = (words[slot] >> 2) & 63u;
+                (void)absb;
+                if (type == 0u && index >= 48u &&
+                    ((handled && rsx_fp_interp_src_used(opcode, slot)) ||
+                     (handled && has_dest && setcond && slot == 0 && 0)))
+                    status |= RSX_FP_INTERP_TEMP;
+            }
+            if (handled && has_dest) {
+                u32 dst_idx = (w0 >> 1) & 63u;
+                if (dst_idx >= 48u) status |= RSX_FP_INTERP_TEMP;
+            }
+        }
+
+        u0 = (opcode & 63u) |
+             (((w0 >> 1) & 63u) << 6) |
+             (((w0 >> 7) & 1u) << 12) |
+             (((w0 >> 30) & 1u) << 13) |
+             (mask << 14) |
+             (((w0 >> 31) & 1u) << 18) |
+             (((w2 >> 28) & 7u) << 19) |
+             (pred << 22) |
+             ((cmp & 7u) << 24) |
+             (cc_read << 27) |
+             (setcond << 28) |
+             (cc_write << 29) |
+             ((!is_branch && (w3 >> 31) != 0) ? 1u << 30 : 0u);
+
+        if (is_branch && (opcode == 0x00u || opcode == 0x02u || opcode == 0x03u || opcode == 0x04u)) {
+            u32 end_at = (w3 & 0x7fffffffu) << 2;
+            int malformed = end_at <= after;
+            u32 end_pc = rsx_fp_interp_map_pc(inst_off, ninst, end_at);
+            if (opcode == 0x02u || opcode == 0x03u || opcode == 0x04u) {
+                if (malformed) {
+                    u0 = 1u << 13; /* NOP, nowrite */
+                    u1 = u2 = u3 = 0;
+                } else {
+                    u32 else_pc = 0xffffu;
+                    u32 init = 0, endn = 0, step = 1;
+                    flow = 1;
+                    branches++;
+                    if (!is_uncond && !is_never) predicated++;
+                    if (opcode == 0x02u) {
+                        u32 else_at = (w2 & 0x7fffffffu) << 2;
+                        u32 mapped = rsx_fp_interp_map_pc(inst_off, ninst, else_at);
+                        if (else_at != end_at && mapped < end_pc && mapped > i)
+                            else_pc = mapped;
+                    } else {
+                        endn = (w2 >> 2) & 0xffu;
+                        init = (w2 >> 10) & 0xffu;
+                        step = (w2 >> 19) & 0xffu;
+                        if (step == 0) step = 1;
+                    }
+                    u0 |= 0x80000000u;
+                    u0 = (u0 & ~(63u)) | (opcode & 63u);
+                    u1 = (else_pc & 0xffffu) | (end_pc << 16);
+                    u2 = (init & 255u) | ((endn & 255u) << 8) | ((step & 255u) << 16);
+                    u3 = cswz & 255u;
+                }
+            } else if (opcode == 0x00u) {
+                flow = 1;
+                branches++;
+                if (!is_uncond && !is_never) predicated++;
+                u0 |= 0x80000000u;
+                u0 = (u0 & ~63u) | 0u;
+                u1 = 0xffffu | (rsx_fp_interp_map_pc(inst_off, ninst, end_at) << 16);
+                u2 = 0;
+                u3 = cswz & 255u;
+            }
+        } else if (is_branch) {
+            /* CAL/RET and any other branch opcode: a NOP slot. */
+            u0 = 1u << 13;
+            u1 = u2 = u3 = 0;
+        } else if (opcode == 0x12u) {
+            u0 = (u0 & ~((1u << 13) | (1u << 28))) | (1u << 13);
+            u0 = (u0 & ~63u) | 0x12u;
+            u1 = 0;
+            u2 = cswz << 22;
+            u3 = 0;
+            if (pred == 2u) predicated++;
+        } else if (!handled) {
+            u0 = 1u << 13;
+            u1 = u2 = u3 = 0;
+        } else {
+            if (opcode == 0x17u || opcode == 0x18u || opcode == 0x2Fu || opcode == 0x31u)
+                textured++;
+            if (pred == 2u) predicated++;
+            u1 = (s0 & 0x3fffffu) | ((input_src & 15u) << 22) |
+                 ((tex_unit & 15u) << 26) | (((w0 >> 21) & 1u) << 30);
+            u2 = (s1 & 0x3fffffu) | ((cswz & 255u) << 22);
+            u3 = (s2 & 0x3fffffu) | ((kslot & 255u) << 22);
+        }
+        (void)flow;
+        if (dst && (status & RSX_FP_INTERP_OVERFLOW) == 0 && i * 4u + 3u < dst_words) {
+            dst[i * 4u + 0] = u0;
+            dst[i * 4u + 1] = u1;
+            dst[i * 4u + 2] = u2;
+            dst[i * 4u + 3] = u3;
+        }
+    }
+
+    info->status = status;
+    info->instructions = ninst;
+    info->constants = nconst;
+    info->wrote_r = wrote_r;
+    info->wrote_h = wrote_h;
+    if (ctrl == RSX_FP_CTRL_AUTO)
+        info->half = ((wrote_r & 1u) || (wrote_h & 1u) == 0u) ? 0u : 1u;
+    else
+        info->half = (ctrl & 0x40u) ? 0u : 1u;
+    info->targets = 1;
+    {
+        u32 bits = info->half ? wrote_h : wrote_r;
+        u32 t;
+        for (t = 3; t >= 1; t--)
+            if (bits & (1u << t)) { info->targets = t + 1u; break; }
+    }
+    info->depth_export = (ctrl != RSX_FP_CTRL_AUTO && (ctrl & 0xEu) != 0u) ? 1u : 0u;
+    info->max_nest = max_nest;
+    info->branches = branches;
+    info->textured = textured;
+    info->predicated = predicated;
+    return status ? -1 : 0;
+}
+
+#endif
diff --git a/libs/video/rsx_fp_interp_backend.inc b/libs/video/rsx_fp_interp_backend.inc
new file mode 100644
index 0000000..2ed1c3b
--- /dev/null
+++ b/libs/video/rsx_fp_interp_backend.inc
@@ -0,0 +1,792 @@
+/* Fragment-interpreter replay. Included at the bottom of rsx_d3d12_backend.c
+ * so it can call that file's static helpers. RSX_SHADER_INTERP unset or 0
+ * returns before any allocation, signature, or binding. This file also owns
+ * what the vertex interpreter (rsx_vp_interp_backend.inc) shares: one pipeline
+ * cache, one signature switch, and the frame-alternating A/B diagnostic. */
+
+#define RSX_FP_INTERP_IMPLEMENTATION
+#define RSX_FP_INTERP_EMBED_HLSL
+#include "rsx_fp_interp.h"
+
+/* Optional private-build output, generated exclusively from our generic HLSL.
+ * It avoids populating or seeding the game's specialized shader cache. */
+#ifdef RSX_SHADER_INTERP_EMBED_DXBC
+#include "rsx_interp_dxbc.inc"
+#endif
+static ID3DBlob* interp_embedded_blob(unsigned variant, const char* src, size_t len,
+                                      const char* target, UINT flags)
+{
+#ifdef RSX_SHADER_INTERP_EMBED_DXBC
+    const char* e = getenv("RSX_SHADER_INTERP_EMBED");
+    if (e && e[0] == '0') return NULL;
+    if (flags || variant >= sizeof(rsx_interp_embedded) / sizeof(rsx_interp_embedded[0])) return NULL;
+    if (rsx_interp_embedded[variant].key != shader_source_key(src, len, target, flags)) return NULL;
+    ID3DBlob* b = NULL;
+    if (FAILED(D3DCreateBlob(rsx_interp_embedded[variant].size, &b)) || !b) return NULL;
+    memcpy(b->lpVtbl->GetBufferPointer(b), rsx_interp_embedded[variant].bytes,
+           rsx_interp_embedded[variant].size);
+    return b;
+#else
+    (void)variant; (void)src; (void)len; (void)target; (void)flags;
+    return NULL;
+#endif
+}
+
+static ID3D12RootSignature* s_interp_rs;
+static ID3DBlob* s_interp_ps[16];
+static ID3D12Resource* s_interp_arena[2];
+static u8* s_interp_map[2];
+static u32 s_interp_arena_bytes;
+static u32 s_interp_used[2];
+static u64 s_interp_tag[2];
+static int s_interp_sig_kind;          /* 0 base, 1 fragment interpreter, 2 vertex-only interpreter */
+static int s_interp_ab_on;             /* RSX_SHADER_INTERP_AB: this replay frame uses the interpreters */
+
+typedef struct { u64 hash; u32 off; u32 nbytes; } InterpProg;
+static InterpProg s_interp_prog[2][4096];
+static u32 s_interp_prog_n[2];
+
+/* One pipeline cache for all three interpreter kinds. Blobs are never freed
+ * while a pipeline names them (specialized VS slots never evict; the
+ * interpreter blobs live to shutdown; a held PS keeps its reference), so
+ * their addresses identify them. */
+typedef struct {
+    const void* vs; const void* ps;
+    u32 blend, cmask, rtfmt, stencil, cull, samples, vmask, packed;
+} InterpPsoKey;
+typedef struct { InterpPsoKey key; ID3D12PipelineState* pso; ID3DBlob* vs_hold; ID3DBlob* ps_hold; } InterpPsoSlot;
+#define INTERP_PSO_MAX 4096
+static InterpPsoSlot s_interp_pso[INTERP_PSO_MAX];
+static u32 s_interp_pso_n;
+static u32 s_interp_img[RSX_FP_INTERP_MAX_INSNS * 4];
+static char s_interp_src[65536];
+
+static struct {
+    u32 draws, fallback, reject, gap, arena, pso_fail;
+    u32 arena_peak, compile_ms;
+    u32 pso_new, pso_ms, pso_max_ms;
+} s_interp_stat;
+
+/* Configured mode: 0 off, 1 only while the specialized stage is pending,
+ * 2 force. Fixed for the process; init and shutdown key off it. */
+static int fp_interp_cfg(void)
+{
+    static int m = -1;
+    if (m >= 0) return m;
+    const char* e = getenv("RSX_SHADER_INTERP");
+    if (!e || !e[0] || e[0] == '0') m = 0;
+    else if (e[0] == 'f' || e[0] == 'F') m = 2;   /* force: every eligible draw */
+    else if (e[0] == '1') m = 1;                  /* only while the specialized PS is pending */
+    else m = 0;
+    return m;
+}
+
+/* Independent default-off counters allow the unchanged async baseline to be
+ * measured without enabling either interpreter. Record and replay counters
+ * each have one producer; the replay thread only reads the record counter. */
+static volatile LONG64 s_interp_skips[3];
+static int interp_stats_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("RSX_SHADER_INTERP_STATS"); on = e && e[0] == '1'; }
+    return on;
+}
+static void interp_note_skip(int stage)
+{
+    if (interp_stats_on() && stage >= 0 && stage < 3) InterlockedIncrement64(&s_interp_skips[stage]);
+}
+static void interp_pending_log_tick(void)
+{
+    if (!interp_stats_on()) return;
+    static ULONGLONG last;
+    ULONGLONG now = GetTickCount64();
+    if (last && now - last < 5000) return;
+    last = now;
+    fprintf(stderr, "[interp-pending] replay_vp=%lld replay_fp=%lld record_vp=%lld pso=%u pso_ms=%u pso_max_ms=%u\n",
+        (long long)InterlockedCompareExchange64(&s_interp_skips[0], 0, 0),
+        (long long)InterlockedCompareExchange64(&s_interp_skips[1], 0, 0),
+        (long long)InterlockedCompareExchange64(&s_interp_skips[2], 0, 0),
+        s_interp_pso_n, s_interp_stat.pso_ms, s_interp_stat.pso_max_ms);
+}
+
+/* Explicit override for the independent-stage switches: use both generic
+ * stages while either is pending. This permits bounded native-class prewarm. */
+static int interp_pair(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("RSX_SHADER_INTERP_PAIR"); on = e && e[0] == '1'; }
+    return on && fp_interp_cfg() && vp_interp_cfg();
+}
+
+static int interp_ab(void)
+{
+    static int a = -1;
+    if (a < 0) { const char* e = getenv("RSX_SHADER_INTERP_AB"); a = e && e[0] && e[0] != '0'; }
+    return a;
+}
+
+/* Mode for this replay frame. With RSX_SHADER_INTERP_AB=1 odd frames run the
+ * specialized shaders and even frames run the configured interpreter mode, so
+ * adjacent presented frames can be compared (see interp_ab_label). */
+static int fp_interp_mode(void)
+{
+    int m = fp_interp_cfg();
+    if (m && interp_ab() && !s_interp_ab_on) return 0;
+    return m;
+}
+
+static void interp_frame_begin(void)
+{
+    /* render_frame_body has just rebound the ordinary root signature. */
+    s_interp_sig_kind = 0;
+    if (interp_ab()) s_interp_ab_on = (s_d3d.frame_count & 1u) == 0;
+    else s_interp_ab_on = 1;
+}
+
+/* Name for a backbuffer dump taken after this frame: NULL unless A/B is on. */
+static const char* interp_ab_label(void)
+{
+    if (!interp_ab()) return NULL;
+    return s_interp_ab_on ? "interp" : "spec";
+}
+
+static u32 fp_interp_srv_extra(void)
+{
+    /* 48 template descriptors plus one 48-wide table per draw record. */
+    if (!fp_interp_cfg()) return 0;
+    return 48u + (u32)MAX_DRAWS * 48u;
+}
+
+static void fp_interp_note_fallback(void) { s_interp_stat.fallback++; }
+
+static D3D12_CPU_DESCRIPTOR_HANDLE fp_interp_cpu(u32 slot)
+{
+    D3D12_CPU_DESCRIPTOR_HANDLE h;
+    s_d3d.srv_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(s_d3d.srv_heap, &h);
+    h.ptr += (SIZE_T)slot * s_d3d.srv_inc;
+    return h;
+}
+
+static void fp_interp_init_views(void)
+{
+    if (!fp_interp_cfg() || !s_d3d.srv_heap || !s_d3d.device) return;
+    D3D12_SHADER_RESOURCE_VIEW_DESC cube = {0};
+    cube.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+    cube.ViewDimension = D3D12_SRV_DIMENSION_TEXTURECUBE;
+    cube.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+    cube.TextureCube.MipLevels = 1;
+    D3D12_SHADER_RESOURCE_VIEW_DESC vol = {0};
+    vol.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+    vol.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE3D;
+    vol.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+    vol.Texture3D.MipLevels = 1;
+    for (u32 i = 0; i < 16; i++) {
+        D3D12_CPU_DESCRIPTOR_HANDLE c = fp_interp_cpu(SRV_HEAP_ALLOC + 16u + i);
+        D3D12_CPU_DESCRIPTOR_HANDLE v = fp_interp_cpu(SRV_HEAP_ALLOC + 32u + i);
+        s_d3d.device->lpVtbl->CreateShaderResourceView(s_d3d.device, NULL, &cube, c);
+        s_d3d.device->lpVtbl->CreateShaderResourceView(s_d3d.device, NULL, &vol, v);
+    }
+}
+
+static void fp_interp_make_root_sig(const D3D12_STATIC_SAMPLER_DESC* samp)
+{
+    if (!fp_interp_cfg() || !s_d3d.device || !samp) return;
+    D3D12_DESCRIPTOR_RANGE rng[3];
+    memset(rng, 0, sizeof rng);
+    rng[0].RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SRV;
+    rng[0].NumDescriptors = 16;
+    rng[0].BaseShaderRegister = 0;
+    rng[0].OffsetInDescriptorsFromTableStart = 0;
+    rng[1].RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SRV;
+    rng[1].NumDescriptors = 16;
+    rng[1].BaseShaderRegister = 32;
+    rng[1].OffsetInDescriptorsFromTableStart = 16;
+    rng[2].RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SRV;
+    rng[2].NumDescriptors = 16;
+    rng[2].BaseShaderRegister = 48;
+    rng[2].OffsetInDescriptorsFromTableStart = 32;
+
+    D3D12_ROOT_PARAMETER rp[9];
+    memset(rp, 0, sizeof rp);
+    rp[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_CBV;
+    rp[0].Descriptor.ShaderRegister = 0;
+    rp[0].ShaderVisibility = D3D12_SHADER_VISIBILITY_VERTEX;
+    rp[1].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+    rp[1].DescriptorTable.NumDescriptorRanges = 3;
+    rp[1].DescriptorTable.pDescriptorRanges = rng;
+    rp[1].ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+    rp[2].ParameterType = D3D12_ROOT_PARAMETER_TYPE_CBV;
+    rp[2].Descriptor.ShaderRegister = 1;
+    rp[2].ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+    rp[3].ParameterType = D3D12_ROOT_PARAMETER_TYPE_SRV;
+    rp[3].Descriptor.ShaderRegister = 20;
+    rp[3].ShaderVisibility = D3D12_SHADER_VISIBILITY_VERTEX;
+    rp[4].ParameterType = D3D12_ROOT_PARAMETER_TYPE_CBV;
+    rp[4].Descriptor.ShaderRegister = 2;
+    rp[4].ShaderVisibility = D3D12_SHADER_VISIBILITY_VERTEX;
+    rp[5].ParameterType = D3D12_ROOT_PARAMETER_TYPE_SRV;
+    rp[5].Descriptor.ShaderRegister = 16;
+    rp[5].ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+    rp[6].ParameterType = D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS;
+    rp[6].Constants.ShaderRegister = 3;
+    rp[6].Constants.Num32BitValues = 4;
+    rp[6].ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+    /* 7 and 8: the vertex interpreter's program (t21) and header (b4), used
+     * when both stages are interpreted in one draw. */
+    rp[7].ParameterType = D3D12_ROOT_PARAMETER_TYPE_SRV;
+    rp[7].Descriptor.ShaderRegister = 21;
+    rp[7].ShaderVisibility = D3D12_SHADER_VISIBILITY_VERTEX;
+    rp[8].ParameterType = D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS;
+    rp[8].Constants.ShaderRegister = 4;
+    rp[8].Constants.Num32BitValues = 4;
+    rp[8].ShaderVisibility = D3D12_SHADER_VISIBILITY_VERTEX;
+
+    D3D12_ROOT_SIGNATURE_DESC rd = {0};
+    rd.NumParameters = 9;
+    rd.pParameters = rp;
+    rd.NumStaticSamplers = RSX_TEX_UNITS;
+    rd.pStaticSamplers = samp;
+    rd.Flags = D3D12_ROOT_SIGNATURE_FLAG_ALLOW_INPUT_ASSEMBLER_INPUT_LAYOUT;
+    ID3DBlob* sig = NULL; ID3DBlob* err = NULL;
+    HRESULT hr = D3D12SerializeRootSignature(&rd, D3D_ROOT_SIGNATURE_VERSION_1, &sig, &err);
+    if (FAILED(hr)) {
+        fprintf(stderr, "[interp] root signature serialize 0x%08lX %s\n", (unsigned long)hr,
+                err ? (const char*)err->lpVtbl->GetBufferPointer(err) : "");
+        if (err) err->lpVtbl->Release(err);
+        return;
+    }
+    hr = s_d3d.device->lpVtbl->CreateRootSignature(s_d3d.device, 0,
+        sig->lpVtbl->GetBufferPointer(sig), sig->lpVtbl->GetBufferSize(sig),
+        &IID_ID3D12RootSignature, (void**)&s_interp_rs);
+    sig->lpVtbl->Release(sig);
+    if (FAILED(hr)) fprintf(stderr, "[interp] root signature create 0x%08lX\n", (unsigned long)hr);
+}
+
+static UINT fp_interp_opt(void)
+{
+    static UINT f = 0xFFFFFFFFu;
+    if (f != 0xFFFFFFFFu) return f;
+    const char* e = getenv("RSX_SHADER_INTERP_OPT");
+    f = !e ? 0u
+         : !strcmp(e, "skip") ? D3DCOMPILE_SKIP_OPTIMIZATION
+         : e[0] == '0' ? D3DCOMPILE_OPTIMIZATION_LEVEL0
+         : e[0] == '2' ? D3DCOMPILE_OPTIMIZATION_LEVEL2
+         : e[0] == '3' ? D3DCOMPILE_OPTIMIZATION_LEVEL3 : 0u;
+    return f;
+}
+
+static ID3DBlob* fp_interp_blob(int full, int sample, int targets)
+{
+    int v = (full ? 8 : 0) + (sample ? 4 : 0) + (targets - 1);
+    if (targets < 1 || targets > 4 || v < 0 || v >= 16) return NULL;
+    if (s_interp_ps[v]) return s_interp_ps[v];
+    int n = rsx_fp_interp_variant_prefix(s_interp_src, sizeof s_interp_src, full, sample, targets);
+    size_t hl = strlen(rsx_fp_interp_hlsl);
+    if (n < 0 || (size_t)n + hl + 1 > sizeof s_interp_src) return NULL;
+    memcpy(s_interp_src + n, rsx_fp_interp_hlsl, hl + 1);
+    ID3DBlob* pb = NULL; ID3DBlob* err = NULL;
+    ULONGLONG t0 = GetTickCount64();
+    pb = interp_embedded_blob((unsigned)v, s_interp_src, (size_t)n + hl, "ps_5_1", fp_interp_opt());
+    HRESULT hr = pb ? S_OK : d3d_compile_cached(s_interp_src, (size_t)n + hl, "rsx_fp_interp", "ps_5_1",
+                                    fp_interp_opt(), &pb, &err);
+    s_interp_stat.compile_ms += (u32)(GetTickCount64() - t0);
+    if (FAILED(hr) || !pb) {
+        static int logged;
+        if (logged < 8) {
+            logged++;
+            fprintf(stderr, "[interp] compile variant %d failed 0x%08lX %s\n", v, (unsigned long)hr,
+                    err ? (const char*)err->lpVtbl->GetBufferPointer(err) : "");
+        }
+        if (err) err->lpVtbl->Release(err);
+        return NULL;
+    }
+    if (err) err->lpVtbl->Release(err);
+    s_interp_ps[v] = pb;
+    fprintf(stderr, "[interp] ps %s %s targets %d: %u bytes\n",
+            full ? "full" : "common", sample ? "sample" : "pixel", targets,
+            (unsigned)pb->lpVtbl->GetBufferSize(pb));
+    return pb;
+}
+
+static void fp_interp_startup(void)
+{
+    if (!fp_interp_cfg() || !s_d3d.device) return;
+    u32 kb = 2048;
+    const char* e = getenv("RSX_SHADER_INTERP_ARENA_KB");
+    if (e && atoi(e) >= 256) kb = (u32)atoi(e);
+    if (kb > 16384u) kb = 16384u;
+    s_interp_arena_bytes = kb << 10;
+    D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_UPLOAD;
+    D3D12_RESOURCE_DESC bd = {0};
+    bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+    bd.Width = s_interp_arena_bytes;
+    bd.Height = 1; bd.DepthOrArraySize = 1; bd.MipLevels = 1;
+    bd.SampleDesc.Count = 1;
+    bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    D3D12_RANGE nr = {0, 0};
+    for (int p = 0; p < 2; p++) {
+        void* mapped = NULL;
+        if (SUCCEEDED(create_dyn_buffer(&hp, &bd, &s_interp_arena[p])) &&
+            SUCCEEDED(s_interp_arena[p]->lpVtbl->Map(s_interp_arena[p], 0, &nr, &mapped)))
+            s_interp_map[p] = (u8*)mapped;
+    }
+    ULONGLONG t0 = GetTickCount64();
+    for (int full = 0; full < 2; full++)
+        for (int sample = 0; sample < 2; sample++)
+            for (int t = 1; t <= 4; t++)
+                fp_interp_blob(full, sample, t);
+    fprintf(stderr, "[interp] mode %d%s arena %u KB warmup %llu ms opt 0x%X\n",
+            fp_interp_cfg(), interp_ab() ? " ab" : "", kb, (unsigned long long)(GetTickCount64() - t0), fp_interp_opt());
+}
+
+static void fp_interp_shutdown(void)
+{
+    for (u32 i = 0; i < s_interp_pso_n; i++) {
+        if (s_interp_pso[i].pso) s_interp_pso[i].pso->lpVtbl->Release(s_interp_pso[i].pso);
+        if (s_interp_pso[i].vs_hold) s_interp_pso[i].vs_hold->lpVtbl->Release(s_interp_pso[i].vs_hold);
+        if (s_interp_pso[i].ps_hold) s_interp_pso[i].ps_hold->lpVtbl->Release(s_interp_pso[i].ps_hold);
+    }
+    s_interp_pso_n = 0;
+    for (int i = 0; i < 16; i++)
+        if (s_interp_ps[i]) { s_interp_ps[i]->lpVtbl->Release(s_interp_ps[i]); s_interp_ps[i] = NULL; }
+    if (s_interp_rs) { s_interp_rs->lpVtbl->Release(s_interp_rs); s_interp_rs = NULL; }
+    for (int p = 0; p < 2; p++) {
+        if (s_interp_arena[p]) {
+            s_interp_arena[p]->lpVtbl->Unmap(s_interp_arena[p], 0, NULL);
+            s_interp_arena[p]->lpVtbl->Release(s_interp_arena[p]);
+            s_interp_arena[p] = NULL;
+        }
+        s_interp_map[p] = NULL;
+    }
+}
+
+static ID3D12RootSignature* s_vp_rs;           /* defined with the vertex interpreter */
+static ID3DBlob* vp_interp_blob(int fetch);
+
+static void interp_sig_reset(void) { s_interp_sig_kind = 0; }
+
+/* kind: 0 the guest signature, 1 the fragment interpreter's, 2 the vertex
+ * interpreter's. A switch invalidates every root binding, which each draw
+ * rebinds after this call. */
+static void interp_set_sig(int kind)
+{
+    ID3D12RootSignature* rs = kind == 1 ? s_interp_rs : kind == 2 ? s_vp_rs : s_d3d.vp_root_sig;
+    if (kind && !rs) kind = 0;
+    if (s_interp_sig_kind == kind) return;
+    s_d3d.cmd_list->lpVtbl->SetGraphicsRootSignature(s_d3d.cmd_list,
+        kind == 1 ? s_interp_rs : kind == 2 ? s_vp_rs : s_d3d.vp_root_sig);
+    s_interp_sig_kind = kind;
+}
+
+static void interp_sig_restore(void)
+{
+    if (s_interp_sig_kind && s_d3d.vp_root_sig && s_d3d.cmd_list)
+        s_d3d.cmd_list->lpVtbl->SetGraphicsRootSignature(s_d3d.cmd_list, s_d3d.vp_root_sig);
+    s_interp_sig_kind = 0;
+}
+
+static void fp_interp_log_tick(void)
+{
+    if (!fp_interp_cfg()) return;
+    static ULONGLONG last;
+    ULONGLONG now = GetTickCount64();
+    if (last && now - last < 5000) return;
+    last = now;
+    fprintf(stderr, "[interp] draws %u fallback %u reject %u gap %u arena %u pso_fail %u pso %u (new ms total %u max %u) peak %uKB compile %ums\n",
+            s_interp_stat.draws, s_interp_stat.fallback, s_interp_stat.reject, s_interp_stat.gap,
+            s_interp_stat.arena, s_interp_stat.pso_fail, s_interp_pso_n,
+            s_interp_stat.pso_ms, s_interp_stat.pso_max_ms,
+            s_interp_stat.arena_peak >> 10, s_interp_stat.compile_ms);
+}
+
+/* Cube wins over volume when both are set: srv_write_ex writes the cube view last. */
+static u32 fp_interp_shape(const D3D12DrawRecord* dr)
+{
+    u32 cubes = cube_units16(dr_cube_mask(dr));
+    u32 vols = dr_volume_mask(dr);
+    u32 shape = 0;
+    for (u32 u = 0; u < 16; u++) {
+        u32 s = (cubes & (1u << u)) ? 1u : (vols & (1u << u)) ? 2u : 0u;
+        shape |= s << (u * 2);
+    }
+    return shape;
+}
+
+static int fp_interp_reads_extra(const u32* img, u32 nins)
+{
+    for (u32 i = 0; i < nins; i++) {
+        const u32* w = img + i * 4;
+        if (w[0] & 0x80000000u) continue;
+        u32 id = (w[1] >> 22) & 15u;
+        if (id < 12u) continue;
+        u32 s0 = w[1] & 0x3FFFFFu, s1 = w[2] & 0x3FFFFFu, s2 = w[3] & 0x3FFFFFu;
+        if ((s0 & 3u) == 1u || (s1 & 3u) == 1u || (s2 & 3u) == 1u) return 1;
+    }
+    return 0;
+}
+
+static u32 fp_interp_header_flags(const D3D12DrawRecord* dr, int half, int nrt,
+                                  DXGI_FORMAT rtfmt, u32 cmask)
+{
+    static int lg = -1, noat = -1, fog = -1, fd = -1, gd = -1;
+    if (lg < 0) { const char* e = getenv("RSX_LG2_ABS"); lg = !(e && e[0] == '0'); }
+    if (noat < 0) noat = getenv("FP_NO_ATEST") ? 1 : 0;
+    if (fog < 0) { const char* e = getenv("RSX_FOG"); fog = !(e && e[0] == '0'); }
+    if (fd < 0) { const char* e = getenv("RSX_FINAL_DITHER"); fd = !(e && e[0] == '0'); }
+    if (gd < 0) { const char* e = getenv("RSX_GAME_DITHER"); gd = e ? e[0] != '0' : !rsx_hp(); }
+    u32 f = lg ? 256u : 0u;
+    if (half) f |= 1u;
+    if (!noat) f |= 16u;
+    if (fog) f |= 32u;
+    if (rs_on()) f |= 64u;
+    if (fd && rsx_hp() && rtfmt == DXGI_FORMAT_R8G8B8A8_UNORM && nrt == 1 && (cmask & 0xEu))
+        f |= 128u;
+    if (!gd) f |= 512u;          /* bit 512: replace the title's small WPOS dither sample with 0.5 */
+    if (dr->srgb_wr) f |= 1024u;
+    return f;
+}
+
+static u32 fp_interp_alloc(int par, u32 bytes)
+{
+    bytes = (bytes + 15u) & ~15u;
+    if (!s_interp_map[par] || s_interp_used[par] + bytes > s_interp_arena_bytes) return 0xFFFFFFFFu;
+    u32 off = s_interp_used[par];
+    s_interp_used[par] += bytes;
+    if (s_interp_used[par] > s_interp_stat.arena_peak) s_interp_stat.arena_peak = s_interp_used[par];
+    return off;
+}
+
+static int fp_interp_ssaa(void)
+{
+    static int ss = -1;
+    if (ss < 0) { const char* e = getenv("RSX_SSAA"); ss = (e && *e == '0') ? 0 : 1; }
+    return ss;
+}
+
+/* Pipeline for one interpreter draw. kind 1 pairs the fragment interpreter
+ * (ps) with either the specialized vertex shader or the vertex interpreter
+ * (vsb); kind 2 pairs the vertex interpreter with a specialized pixel shader.
+ * Nothing in the key names a guest program: only blobs and native state. */
+static ID3D12PipelineState* interp_get_pso(int kind, ID3DBlob* vsb, ID3DBlob* ps, int gpu, u32 vmask_in,
+                                           int nrt, DXGI_FORMAT rtfmt, u32 blend, u32 cmask, u32 cull,
+                                           u32 cube_mask, u32 stencil)
+{
+    ID3D12RootSignature* rs = kind == 1 ? s_interp_rs : s_vp_rs;
+    if (!vsb || !ps || !rs) return NULL;
+    u32 samples = (cube_mask >> 16) & 0xFu; if (!samples) samples = 1;
+    if (nrt < 1) nrt = 1; if (nrt > 4) nrt = 4;
+    InterpPsoKey key;
+    memset(&key, 0, sizeof key);
+    key.vs = vsb; key.ps = ps; key.blend = blend; key.cmask = cmask; key.rtfmt = (u32)rtfmt;
+    key.stencil = stencil; key.cull = cull; key.samples = samples;
+    key.vmask = gpu ? 0u : (vmask_in ? vmask_in : 0xFFFFu);
+    key.packed = (u32)nrt | ((u32)(gpu ? 1 : 0) << 8) | ((u32)kind << 16);
+    for (u32 i = 0; i < s_interp_pso_n; i++)
+        if (memcmp(&s_interp_pso[i].key, &key, sizeof key) == 0) return s_interp_pso[i].pso;
+    if (s_interp_pso_n >= INTERP_PSO_MAX) { s_interp_stat.pso_fail++; return NULL; }
+
+    D3D12_INPUT_ELEMENT_DESC il[16];
+    u32 vmask = key.vmask ? key.vmask : 0xFFFFu;
+    for (int i = 0; i < 16; i++) {
+        il[i].SemanticName = "ATTR"; il[i].SemanticIndex = (UINT)i;
+        il[i].Format = DXGI_FORMAT_R32G32B32A32_FLOAT; il[i].InputSlot = 0;
+        u32 r = 0; for (int j = 0; j < i; j++) if (vmask & (1u << j)) r++;
+        il[i].AlignedByteOffset = (vmask & (1u << i)) ? (UINT)(r * 16) : 0;
+        il[i].InputSlotClass = D3D12_INPUT_CLASSIFICATION_PER_VERTEX_DATA;
+        il[i].InstanceDataStepRate = 0;
+    }
+    D3D12_GRAPHICS_PIPELINE_STATE_DESC pd;
+    memset(&pd, 0, sizeof pd);
+    pd.pRootSignature = s_interp_rs;
+    pd.VS.pShaderBytecode = vsb->lpVtbl->GetBufferPointer(vsb);
+    pd.VS.BytecodeLength = vsb->lpVtbl->GetBufferSize(vsb);
+    pd.PS.pShaderBytecode = ps->lpVtbl->GetBufferPointer(ps);
+    pd.PS.BytecodeLength = ps->lpVtbl->GetBufferSize(ps);
+    pd.InputLayout.pInputElementDescs = il;
+    pd.InputLayout.NumElements = gpu ? 0u : 16u;
+    pd.RasterizerState.FillMode = D3D12_FILL_MODE_SOLID;
+    { static int co = -1, cfl = -1;
+      if (co < 0) co = getenv("CULL_OFF") ? 1 : 0;
+      if (cfl < 0) cfl = getenv("CULL_FLIP") ? 1 : 0;
+      pd.RasterizerState.CullMode = (!co && (cull & 1u))
+          ? ((cull & 2u) ? D3D12_CULL_MODE_FRONT : D3D12_CULL_MODE_BACK)
+          : D3D12_CULL_MODE_NONE;
+      pd.RasterizerState.FrontCounterClockwise = (((cull & 4u) ? 1 : 0) ^ cfl) ? TRUE : FALSE; }
+    pd.BlendState.RenderTarget[0].BlendEnable = (blend & 1) ? TRUE : FALSE;
+    pd.BlendState.RenderTarget[0].SrcBlend = (blend & 1) ? (D3D12_BLEND)((blend >> 1) & 0x1F) : D3D12_BLEND_ONE;
+    pd.BlendState.RenderTarget[0].DestBlend = (blend & 1) ? (D3D12_BLEND)((blend >> 6) & 0x1F) : D3D12_BLEND_ZERO;
+    pd.BlendState.RenderTarget[0].BlendOp = (blend & 1) ? (D3D12_BLEND_OP)((blend >> 21) & 0x7) : D3D12_BLEND_OP_ADD;
+    pd.BlendState.RenderTarget[0].SrcBlendAlpha = (blend & 1) ? (D3D12_BLEND)((blend >> 11) & 0x1F) : D3D12_BLEND_ONE;
+    pd.BlendState.RenderTarget[0].DestBlendAlpha = (blend & 1) ? (D3D12_BLEND)((blend >> 16) & 0x1F) : D3D12_BLEND_ZERO;
+    pd.BlendState.RenderTarget[0].BlendOpAlpha = (blend & 1) ? (D3D12_BLEND_OP)((blend >> 24) & 0x7) : D3D12_BLEND_OP_ADD;
+    pd.BlendState.RenderTarget[0].RenderTargetWriteMask = D3D12_COLOR_WRITE_ENABLE_ALL;
+    pd.SampleMask = UINT_MAX;
+    pd.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
+    if (nrt < 1) nrt = 1; if (nrt > 4) nrt = 4;
+    pd.NumRenderTargets = (UINT)nrt;
+    for (int r = 0; r < nrt; r++) {
+        pd.RTVFormats[r] = rtfmt;
+        pd.BlendState.RenderTarget[r] = pd.BlendState.RenderTarget[0];
+    }
+    { static int cf = -1; if (cf < 0) cf = getenv("CMASK_FORCE") ? 1 : 0;
+      if (cf) cmask = 0xF; }
+    for (int r = 0; r < nrt; r++)
+        pd.BlendState.RenderTarget[r].RenderTargetWriteMask = (UINT8)(cmask & 0xF);
+    pd.DSVFormat = DXGI_FORMAT_D24_UNORM_S8_UINT;
+    pd.DepthStencilState.DepthEnable = TRUE;
+    pd.DepthStencilState.DepthWriteMask = D3D12_DEPTH_WRITE_MASK_ALL;
+    pd.DepthStencilState.DepthFunc = D3D12_COMPARISON_FUNC_LESS_EQUAL;
+    if (depth_state_on()) {
+        pd.DepthStencilState.DepthFunc = (D3D12_COMPARISON_FUNC)(((stencil >> 28) & 7u) + 1u);
+        if (stencil & (1u << 31)) pd.DepthStencilState.DepthWriteMask = D3D12_DEPTH_WRITE_MASK_ZERO;
+    }
+    if (stencil & (1u << 26)) {
+        u32 op = (stencil >> 13) & 0xF;
+        D3D12_BLEND sc = op == 6 ? D3D12_BLEND_INV_DEST_COLOR :
+                         (op == 2 || op == 1) ? D3D12_BLEND_ZERO : D3D12_BLEND_ONE;
+        D3D12_BLEND sa = op == 6 ? D3D12_BLEND_INV_DEST_ALPHA :
+                         (op == 2 || op == 1) ? D3D12_BLEND_ZERO : D3D12_BLEND_ONE;
+        D3D12_BLEND dd = op == 1 ? D3D12_BLEND_ONE : D3D12_BLEND_ZERO;
+        for (int r = 0; r < nrt; r++) {
+            pd.BlendState.RenderTarget[r].BlendEnable = TRUE;
+            pd.BlendState.RenderTarget[r].SrcBlend = sc;
+            pd.BlendState.RenderTarget[r].DestBlend = dd;
+            pd.BlendState.RenderTarget[r].BlendOp = D3D12_BLEND_OP_ADD;
+            pd.BlendState.RenderTarget[r].SrcBlendAlpha = sa;
+            pd.BlendState.RenderTarget[r].DestBlendAlpha = dd;
+            pd.BlendState.RenderTarget[r].BlendOpAlpha = D3D12_BLEND_OP_ADD;
+            pd.BlendState.RenderTarget[r].RenderTargetWriteMask = D3D12_COLOR_WRITE_ENABLE_ALL;
+        }
+        pd.DepthStencilState.DepthEnable = FALSE;
+        pd.DepthStencilState.DepthWriteMask = D3D12_DEPTH_WRITE_MASK_ZERO;
+    } else if (stencil & 1u) {
+        D3D12_DEPTH_STENCILOP_DESC so;
+        so.StencilFunc = (D3D12_COMPARISON_FUNC)((stencil >> 1) & 0xF);
+        so.StencilFailOp = (D3D12_STENCIL_OP)((stencil >> 5) & 0xF);
+        so.StencilDepthFailOp = (D3D12_STENCIL_OP)((stencil >> 9) & 0xF);
+        so.StencilPassOp = (D3D12_STENCIL_OP)((stencil >> 13) & 0xF);
+        pd.DepthStencilState.StencilEnable = TRUE;
+        pd.DepthStencilState.StencilReadMask = (UINT8)((stencil >> 17) & 0xFF);
+        pd.DepthStencilState.StencilWriteMask = 0xFF;
+        pd.DepthStencilState.FrontFace = so;
+        pd.DepthStencilState.BackFace = so;
+        if (stencil & (1u << 25)) {
+            pd.DepthStencilState.DepthEnable = FALSE;
+            pd.DepthStencilState.DepthWriteMask = D3D12_DEPTH_WRITE_MASK_ZERO;
+        }
+    }
+    { static int pa = -1;
+      if (pa < 0) pa = getenv("PSO_DSV_ALWAYS") ? 1 : 0;
+      if ((stencil & (1u << 27)) && !pa) {
+          pd.DSVFormat = DXGI_FORMAT_UNKNOWN;
+          pd.DepthStencilState.DepthEnable = FALSE;
+          pd.DepthStencilState.DepthWriteMask = D3D12_DEPTH_WRITE_MASK_ZERO;
+          pd.DepthStencilState.StencilEnable = FALSE;
+      } }
+    { static int doff = -1;
+      if (doff < 0) { const char* e = getenv("DEPTH_OFF"); doff = e ? atoi(e) : 0; }
+      if (doff) { pd.DepthStencilState.DepthEnable = FALSE;
+                  pd.DepthStencilState.DepthWriteMask = D3D12_DEPTH_WRITE_MASK_ZERO; } }
+    pd.pRootSignature = rs;
+    pd.SampleDesc.Count = samples;
+    LARGE_INTEGER q0, q1, qf;
+    QueryPerformanceFrequency(&qf);
+    QueryPerformanceCounter(&q0);
+    ID3D12PipelineState* pso = NULL;
+    HRESULT hr = s_d3d.device->lpVtbl->CreateGraphicsPipelineState(
+        s_d3d.device, &pd, &IID_ID3D12PipelineState, (void**)&pso);
+    QueryPerformanceCounter(&q1);
+    u32 ms = (u32)((q1.QuadPart - q0.QuadPart) * 1000ll / qf.QuadPart);
+    if (FAILED(hr) || !pso) {
+        s_interp_stat.pso_fail++;
+        static int logged;
+        if (logged < 16) {
+            logged++;
+            fprintf(stderr, "[interp] PSO fail 0x%08lX kind=%d nrt=%d fmt=%u samples=%u gpu=%d\n",
+                    (unsigned long)hr, kind, nrt, (unsigned)rtfmt, samples, gpu ? 1 : 0);
+        }
+        return NULL;
+    }
+    s_interp_stat.pso_new++;
+    s_interp_stat.pso_ms += ms;
+    if (ms > s_interp_stat.pso_max_ms) s_interp_stat.pso_max_ms = ms;
+    s_interp_pso[s_interp_pso_n].key = key;
+    s_interp_pso[s_interp_pso_n].pso = pso;
+    /* Blob addresses form the key: keep them alive across specialized-cache flushes. */
+    vsb->lpVtbl->AddRef(vsb); ps->lpVtbl->AddRef(ps);
+    s_interp_pso[s_interp_pso_n].vs_hold = vsb;
+    s_interp_pso[s_interp_pso_n].ps_hold = ps;
+    s_interp_pso_n++;
+    { static int logk = -1;
+      if (logk < 0) { const char* e = getenv("RSX_SHADER_INTERP_LOG"); logk = e && e[0] == '1'; }
+      if (logk && s_interp_pso_n <= 64)
+          fprintf(stderr, "[interp] pso %u kind=%d nrt=%d fmt=%u samples=%u gpu=%d create %u ms\n",
+                  s_interp_pso_n, kind, nrt, (unsigned)rtfmt, samples, gpu ? 1 : 0, ms); }
+    return pso;
+}
+
+/* Precreate only native/input classes already present in the verified starter,
+ * with the generic stage pair. No program bytes, keys or material state enter
+ * these pipelines. Unseen classes still use the bounded first-use path. */
+static void interp_prewarm(void)
+{
+    const char* e = getenv("RSX_SHADER_INTERP_PREWARM");
+    if (!e || e[0] != '1' || !fp_interp_cfg() || !vp_interp_cfg()) return;
+#ifdef RSX_SHADER_INTERP_EMBED_DXBC
+    ULONGLONG t0 = GetTickCount64();
+    u32 before = s_interp_pso_n;
+    for (unsigned i = 0; i < sizeof(rsx_interp_classes) / sizeof(rsx_interp_classes[0]); i++) {
+        u32 samples = (rsx_interp_classes[i].cube >> 16) & 15u;
+        for (int full = 0; full < 2; full++)
+            interp_get_pso(1, vp_interp_blob(rsx_interp_classes[i].gpu),
+                fp_interp_blob(full, fp_interp_ssaa() && samples > 1, (int)rsx_interp_classes[i].nrt),
+                (int)rsx_interp_classes[i].gpu, rsx_interp_classes[i].vmask,
+                (int)rsx_interp_classes[i].nrt, (DXGI_FORMAT)rsx_interp_classes[i].fmt,
+                rsx_interp_classes[i].blend, rsx_interp_classes[i].cmask,
+                rsx_interp_classes[i].cull, rsx_interp_classes[i].cube, rsx_interp_classes[i].stencil);
+    }
+    fprintf(stderr, "[interp-prewarm] pipelines=%u wall_ms=%llu driver_ms=%u max_ms=%u failures=%u\n",
+        s_interp_pso_n - before, (unsigned long long)(GetTickCount64() - t0),
+        s_interp_stat.pso_ms, s_interp_stat.pso_max_ms, s_interp_stat.pso_fail);
+    /* Keep startup cost separate from subsequent first-use calls. */
+    s_interp_stat.pso_ms = s_interp_stat.pso_max_ms = s_interp_stat.pso_new = 0;
+#else
+    fprintf(stderr, "[interp-prewarm] unavailable: build has no embedded native-class metadata\n");
+#endif
+}
+
+/* vp_stage: the vertex interpreter's program is already staged for this draw,
+ * so the pipeline pairs the fragment interpreter with the vertex interpreter
+ * instead of the specialized vertex shader. */
+static ID3D12PipelineState* fp_interp_prepare(const D3D12DrawRecord* dr, u32 draw_i,
+    int nrt, DXGI_FORMAT rtfmt, u32 blend, u32 cmask, u32 cull, u32 cube_mask, u32 stencil,
+    int vp_stage, u32* hdr_off)
+{
+    if (!fp_interp_mode() || !dr || !dr->fp_addr || !hdr_off) return NULL;
+    if (draw_i >= MAX_DRAWS) return NULL;
+    if (dr->tex_dz || dr->tex_mip) { s_interp_stat.gap++; return NULL; }
+    if (s_device_lost || !s_interp_rs) return NULL;
+    extern uint8_t* vm_base;
+    extern u32 cellGcmResolveLocated(int local, u32 offset);
+    if (!vm_base) return NULL;
+    u32 loc = cellGcmResolveLocated((dr->fp_addr & 0x3u) == 1, dr->fp_addr & ~0x3u);
+    if (loc == 0xFFFFFFFFu) return NULL;
+    const u8* code = vm_base + loc;
+    static int ctl_auto = -1;
+    if (ctl_auto < 0) ctl_auto = getenv("FP_CTRL_AUTO") ? 1 : 0;
+    u32 ctrl = ctl_auto ? RSX_FP_CTRL_AUTO : (dr->fp_exp32 ? 0x40u : 0u);
+    rsx_fp_interp_info info;
+    memset(&info, 0, sizeof info);
+    if (rsx_fp_interp_encode(code, FP_UCODE_MAX, ctrl, s_interp_img,
+                             RSX_FP_INTERP_MAX_INSNS * 4u, &info)) {
+        s_interp_stat.reject++;
+        return NULL;
+    }
+    int par = FR->parity & 1;
+    if (!s_interp_map[par]) return NULL;
+    if (s_interp_tag[par] != s_d3d.frame_count) {
+        s_interp_tag[par] = s_d3d.frame_count;
+        s_interp_used[par] = 0;
+        s_interp_prog_n[par] = 0;
+    }
+    u32 nbytes = info.instructions * 16u;
+    u64 hash = 1469598103934665603ull;
+    for (u32 i = 0; i < nbytes; i++) {
+        hash ^= ((const u8*)s_interp_img)[i];
+        hash *= 1099511628211ull;
+    }
+    u32 ioff = 0xFFFFFFFFu;
+    for (u32 i = 0; i < s_interp_prog_n[par]; i++)
+        if (s_interp_prog[par][i].hash == hash && s_interp_prog[par][i].nbytes == nbytes) {
+            ioff = s_interp_prog[par][i].off;
+            break;
+        }
+    if (ioff == 0xFFFFFFFFu) {
+        ioff = fp_interp_alloc(par, nbytes ? nbytes : 16u);
+        if (ioff == 0xFFFFFFFFu) { s_interp_stat.arena++; return NULL; }
+        if (nbytes) memcpy(s_interp_map[par] + ioff, s_interp_img, nbytes);
+        if (s_interp_prog_n[par] < 4096) {
+            InterpProg* slot = &s_interp_prog[par][s_interp_prog_n[par]++];
+            slot->hash = hash; slot->off = ioff; slot->nbytes = nbytes;
+        }
+    }
+    u32 hoff = fp_interp_alloc(par, 64u);
+    if (hoff == 0xFFFFFFFFu) { s_interp_stat.arena++; return NULL; }
+    u32 dim[16][2];
+    u32 un_lo = dr_unnorm(dr, dim);
+    u32 un = (un_lo & 0xFu) | (dr_unnorm_hi(dr) & 0xFFF0u);
+    u32 srgb = (u32)(dr->tex_gamma & 0xFu) | (u32)dr->tex_gamma_hi;
+    if (dr->tex_dz) srgb &= ~(u32)(dr->tex_dz & 0xFu);
+    { const char* e = getenv("RSX_SHADER_INTERP_GAMMA_READ"); if (e && e[0] == '0') srgb = 0; }
+    u32 shadow = 0;
+    if (dr->tex_shd) {
+        static int sh_off = -1, soft = -1;
+        if (sh_off < 0) { const char* e = getenv("RSX_SHADOW"); sh_off = e && e[0] == '0'; }
+        if (soft < 0) { const char* e = getenv("RSX_SHADOW_SOFT"); soft = !(e && e[0] == '0'); }
+        u32 func = sh_off ? 7u : (dr->shd_func & 7u);
+        shadow = (u32)dr->tex_shd | (func << 16) | (soft ? (1u << 19) : 0u);
+    }
+    u32 flags = fp_interp_header_flags(dr, info.half != 0, nrt, rtfmt, cmask);
+    u32 hdr[16];
+    memset(hdr, 0, sizeof hdr);
+    hdr[0] = ioff; hdr[1] = info.instructions; hdr[2] = flags; hdr[3] = fp_interp_shape(dr);
+    hdr[4] = un; hdr[5] = srgb; hdr[6] = shadow;
+    hdr[7] = (u32)dr->samp_key; hdr[8] = (u32)(dr->samp_key >> 32);
+    memcpy(s_interp_map[par] + hoff, hdr, sizeof hdr);
+    u32 samples = (cube_mask >> 16) & 0xFu;
+    int sample = fp_interp_ssaa() && samples > 1;
+    int targets = nrt < 1 ? 1 : nrt > 4 ? 4 : nrt;
+    int full = fp_interp_reads_extra(s_interp_img, info.instructions);
+    ID3DBlob* ps = fp_interp_blob(full, sample, targets);
+    if (!ps) return NULL;
+    ID3DBlob* vsb = NULL; int gpu = 0;
+    if (vp_stage) {
+        gpu = gf_slot(draw_i) ? 1 : 0;
+        vsb = vp_interp_blob(gpu);
+    } else {
+        int vs_idx = dr->vs_idx;
+        if (vs_idx >= 0 && vs_idx < s_d3d.vp_vs_n) {
