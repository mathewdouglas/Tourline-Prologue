+/* ---- Texture allocation pool and staging ring (developer experiment, default off) ----
+ * A new texture upload made two committed resources: the DEFAULT-heap texture and its own UPLOAD-heap staging
+ * buffer, about 1 ms together. A burst of new textures (cars and signs entering view at a race start) spent
+ * 100-200 ms of one frame in CreateCommittedResource.
+ *   RSX_TEX_POOL=1       a texture evicted from a slot because its shape changed is parked, not released, and a
+ *                        later texture of the identical resource description takes it (no allocation). Bounded by
+ *                        RSX_TEX_POOL_MB (default 256) and 512 entries, oldest released first.
+ *   RSX_TEX_RING_MB=<n>  with RSX_TEX_POOL=1, staging data goes through one persistently mapped upload buffer of
+ *                        n MB (default 64; 0 = off), reset after the per-batch GPU drain (wait_for_gpu at the start
+ *                        of render_frame_body). An upload that does not fit uses the old per-slot buffer.
+ * RSX_TEX_POOL unset/0 is the rollback: both paths are skipped. Stats: [tex-pool] every 5 s. */
+static int tex_pool_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("RSX_TEX_POOL"); on = e && !strcmp(e, "1"); }
+    return on;
+}
+#define TEX_POOL_MAX 512
+typedef struct { ID3D12Resource* res; D3D12_RESOURCE_DESC desc; u64 bytes; } TexPoolEnt;
+static TexPoolEnt s_tex_pool[TEX_POOL_MAX];
+static u32 s_tex_pool_n;
+static u64 s_tex_pool_bytes;
+static struct { u64 put, hit, miss, dropped, ring_up, ring_fallback, ring_bytes_peak; double create_ms; u64 creates; } s_tex_pool_stat;
+static u64 tex_pool_cap(void)
+{
+    static u64 cap = 0;
+    if (!cap) { const char* e = getenv("RSX_TEX_POOL_MB"); long mb = e ? atol(e) : 256; if (mb < 1) mb = 1; if (mb > 4096) mb = 4096;
+                cap = (u64)mb << 20; }
+    return cap;
+}
+static void tex_pool_drop_oldest(void)
+{
+    if (!s_tex_pool_n) return;
+    s_tex_pool[0].res->lpVtbl->Release(s_tex_pool[0].res);
+    s_tex_pool_bytes -= s_tex_pool[0].bytes;
+    memmove(&s_tex_pool[0], &s_tex_pool[1], (s_tex_pool_n - 1) * sizeof s_tex_pool[0]);
+    s_tex_pool_n--;
+    s_tex_pool_stat.dropped++;
+}
+/* Park a texture whose slot is changing shape. Its last use was recorded in an earlier batch, which the
+ * per-batch GPU drain has completed, or in this batch (then the pool keeps it alive past that use). */
+static void tex_pool_put(ID3D12Resource* r)
+{
+    D3D12_RESOURCE_DESC d; r->lpVtbl->GetDesc(r, &d);
+    D3D12_RESOURCE_ALLOCATION_INFO ai;
+    s_d3d.device->lpVtbl->GetResourceAllocationInfo(s_d3d.device, &ai, 0, 1, &d);
+    u64 bytes = ai.SizeInBytes;
+    if (bytes > tex_pool_cap()) { r->lpVtbl->Release(r); s_tex_pool_stat.dropped++; return; }
+    while (s_tex_pool_n && (s_tex_pool_n >= TEX_POOL_MAX || s_tex_pool_bytes + bytes > tex_pool_cap()))
+        tex_pool_drop_oldest();
+    s_tex_pool[s_tex_pool_n].res = r; s_tex_pool[s_tex_pool_n].desc = d; s_tex_pool[s_tex_pool_n].bytes = bytes;
+    s_tex_pool_n++; s_tex_pool_bytes += bytes; s_tex_pool_stat.put++;
+}
+static ID3D12Resource* tex_pool_take(const D3D12_RESOURCE_DESC* want)
+{
+    for (u32 i = s_tex_pool_n; i-- > 0;) {
+        const D3D12_RESOURCE_DESC* d = &s_tex_pool[i].desc;
+        if (d->Dimension == want->Dimension && d->Width == want->Width && d->Height == want->Height &&
+            d->DepthOrArraySize == want->DepthOrArraySize && d->MipLevels == want->MipLevels &&
+            d->Format == want->Format && d->SampleDesc.Count == want->SampleDesc.Count && d->Flags == want->Flags) {
+            ID3D12Resource* r = s_tex_pool[i].res;
+            s_tex_pool_bytes -= s_tex_pool[i].bytes;
+            memmove(&s_tex_pool[i], &s_tex_pool[i + 1], (s_tex_pool_n - i - 1) * sizeof s_tex_pool[0]);
+            s_tex_pool_n--; s_tex_pool_stat.hit++;
+            return r;
+        }
+    }
+    s_tex_pool_stat.miss++;
+    return NULL;
+}
+static ID3D12Resource* s_tex_ring;
+static u8* s_tex_ring_map;
+static u64 s_tex_ring_size, s_tex_ring_used;
+static int s_tex_ring_failed;
+static u64 tex_ring_bytes(void)
+{
+    static long mb = -1;
+    if (mb < 0) { const char* e = getenv("RSX_TEX_RING_MB"); mb = e ? atol(e) : 64; if (mb < 0) mb = 0; if (mb > 1024) mb = 1024; }
+    return tex_pool_on() ? (u64)mb << 20 : 0;
+}
+/* Space for one upload in the ring, 512-byte aligned (D3D12_TEXTURE_DATA_PLACEMENT_ALIGNMENT). */
+static int tex_ring_take(u64 bytes, u64* off)
+{
+    if (!tex_ring_bytes() || s_tex_ring_failed) return 0;
+    if (!s_tex_ring) {
+        D3D12_HEAP_PROPERTIES hu = {0}; hu.Type = D3D12_HEAP_TYPE_UPLOAD;
+        D3D12_RESOURCE_DESC bd = {0};
+        bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; bd.Width = tex_ring_bytes();
+        bd.Height = 1; bd.DepthOrArraySize = 1; bd.MipLevels = 1; bd.SampleDesc.Count = 1;
+        bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+        void* m = NULL; D3D12_RANGE nr = {0, 0};
+        if (FAILED(s_d3d.device->lpVtbl->CreateCommittedResource(s_d3d.device, &hu, D3D12_HEAP_FLAG_NONE, &bd,
+                D3D12_RESOURCE_STATE_GENERIC_READ, NULL, &IID_ID3D12Resource, (void**)&s_tex_ring)) ||
+            FAILED(s_tex_ring->lpVtbl->Map(s_tex_ring, 0, &nr, &m)) || !m) {
+            if (s_tex_ring) { s_tex_ring->lpVtbl->Release(s_tex_ring); s_tex_ring = NULL; }
+            s_tex_ring_failed = 1;
+            fprintf(stderr, "[tex-pool] staging ring unavailable; per-texture staging kept\n");
+            return 0;
+        }
+        s_tex_ring_map = (u8*)m; s_tex_ring_size = tex_ring_bytes(); s_tex_ring_used = 0;
+    }
+    u64 o = (s_tex_ring_used + 511u) & ~(u64)511u;
+    if (o + bytes > s_tex_ring_size) { s_tex_pool_stat.ring_fallback++; return 0; }
+    s_tex_ring_used = o + bytes;
+    if (s_tex_ring_used > s_tex_pool_stat.ring_bytes_peak) s_tex_pool_stat.ring_bytes_peak = s_tex_ring_used;
+    s_tex_pool_stat.ring_up++;
+    *off = o;
+    return 1;
+}
+/* After the per-batch GPU drain: everything the previous batch copied from the ring has executed. */
+static void tex_ring_reset(void) { s_tex_ring_used = 0; }
+static void tex_pool_log(void)
+{
+    if (!tex_pool_on()) return;
+    static ULONGLONG last;
+    ULONGLONG now = GetTickCount64();
+    if (last && now - last < 5000) return;
+    last = now;
+    fprintf(stderr, "[tex-pool] put %llu hit %llu miss %llu dropped %llu parked %u (%llu MB) creates %llu (%.0f ms) "
+        "ring uploads %llu fallback %llu peak %llu KB\n",
+        (unsigned long long)s_tex_pool_stat.put, (unsigned long long)s_tex_pool_stat.hit,
+        (unsigned long long)s_tex_pool_stat.miss, (unsigned long long)s_tex_pool_stat.dropped, s_tex_pool_n,
+        (unsigned long long)(s_tex_pool_bytes >> 20), (unsigned long long)s_tex_pool_stat.creates,
+        s_tex_pool_stat.create_ms, (unsigned long long)s_tex_pool_stat.ring_up,
+        (unsigned long long)s_tex_pool_stat.ring_fallback, (unsigned long long)(s_tex_pool_stat.ring_bytes_peak >> 10));
+}
+static void tex_pool_shutdown(void)
+{
+    while (s_tex_pool_n) tex_pool_drop_oldest();
+    if (s_tex_ring) { s_tex_ring->lpVtbl->Unmap(s_tex_ring, 0, NULL); s_tex_ring->lpVtbl->Release(s_tex_ring); s_tex_ring = NULL; }
+}
