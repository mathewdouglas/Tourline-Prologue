+/* RSX_PSO_COVERAGE=1 (default off): one line per distinct complete native
+ * pipeline key a live draw requests. The key is guest_pso_hash(), which is
+ * guest_pso_hash_ex with the root signature, and it honors RSX_PSO_KEY_RS.
+ * It is not a shader id, the renderer's VP/FP cache key, GPU residency, or
+ * the pipeline-metrics counters (shader compiles, driver calls, demand jobs,
+ * warm hits). Those stay on their own line.
+ *
+ * Only the guest-FP request in the executing VP draw counts. The prepass that
+ * pre-builds PSOs, startup and race warmup, offline library and reconstruct
+ * preparation, and capture snapshots do not. A draw with no guest FP uses the
+ * fallback pipeline and is omitted. A decompile or device failure before a
+ * descriptor exists is omitted too: no key is invented.
+ *
+ * While the vertex shader or pixel-shader bytecode is not ready, that guest-FP
+ * submission is counted in pending_shader_draws and no key is emitted. The
+ * count is submissions, not distinct keys, and the same draw repeats each
+ * frame until bytecode exists. A draw with no guest FP is not counted: it
+ * never has this native key. A later frame that forms the descriptor emits
+ * that key once. Driver-pipeline E_PENDING still
+ * has a complete key, so it is recorded and is not a pending-shader draw.
+ * outcome=warm_hit|demand is not printed. A resident-table hit is also taken
+ * by preparation and by the prepass, and it is not GPU residency.
+ *
+ * The set holds 16384 keys. A new key past that sets truncated=1 and is
+ * neither stored nor emitted; unique is then only the stored count, not the
+ * true total. Summary totals are cumulative. They are emitted on the same
+ * five-second stats cadence, after each new key, and on first overflow.
+ * These are log snapshots, not proof of orderly shutdown or route completion.
+ * Shutdown and its wait policy are deliberately untouched. */
+#define PSO_COVERAGE_CAP 16384u
+#define PSO_COVERAGE_SLOTS 32768u
+static SRWLOCK s_pso_use_lock = SRWLOCK_INIT;
+static u64 s_pso_use_key[PSO_COVERAGE_SLOTS];
+static unsigned char s_pso_use_occ[PSO_COVERAGE_SLOTS];
+static u32 s_pso_use_unique, s_pso_use_recorded;
+static int s_pso_use_truncated, s_pso_use_draw;
+static volatile LONG64 s_pso_use_pending;
+static int pso_coverage_on(void)
+{
+    static volatile LONG on = -1;
+    LONG value = InterlockedCompareExchange(&on, -1, -1);
+    if (value < 0) {
+        const char* e = getenv("RSX_PSO_COVERAGE");
+        value = e && !strcmp(e, "1");
+        InterlockedCompareExchange(&on, value, -1);
+    }
+    return value;
+}
+static void pso_coverage_count_pending(void)
+{
+    if (pso_coverage_on()) InterlockedIncrement64(&s_pso_use_pending);
+}
+static void pso_coverage_snapshot_locked(void)
+{
+    fprintf(stderr,
+        "[pipeline-use-summary] format=1 unique=%u recorded=%u truncated=%d pending_shader_draws=%llu\n",
+        s_pso_use_unique, s_pso_use_recorded, s_pso_use_truncated ? 1 : 0,
+        (unsigned long long)InterlockedCompareExchange64(&s_pso_use_pending, 0, 0));
+}
+static void pso_coverage_truncate_locked(void)
+{
+    if (!s_pso_use_truncated) {
+        s_pso_use_truncated = 1;
+        /* Emit before returning: window close may be followed by an owned
+         * process kill, with no later periodic or shutdown callback. */
+        pso_coverage_snapshot_locked();
+    }
+}
+static void pso_coverage_note(u64 key)
+{
+    u32 slot;
+    if (!s_pso_use_draw || !pso_coverage_on()) return;
+    AcquireSRWLockExclusive(&s_pso_use_lock);
+    slot = (u32)key & (PSO_COVERAGE_SLOTS - 1u);
+    for (u32 n = 0; n < PSO_COVERAGE_SLOTS; n++, slot = (slot + 1u) & (PSO_COVERAGE_SLOTS - 1u)) {
+        if (s_pso_use_occ[slot]) {
+            if (s_pso_use_key[slot] == key) goto done;
+            continue;
+        }
+        if (s_pso_use_unique >= PSO_COVERAGE_CAP) { pso_coverage_truncate_locked(); goto done; }
+        s_pso_use_occ[slot] = 1;
+        s_pso_use_key[slot] = key;
+        if (fprintf(stderr, "[pipeline-use] key=%016llx\n", (unsigned long long)key) > 0) {
+            s_pso_use_unique++;
+            s_pso_use_recorded++;
+            /* Keep each newly recorded key in a complete bounded snapshot,
+             * even when the process exits before the next periodic report. */
+            pso_coverage_snapshot_locked();
+            goto done;
+        }
+        s_pso_use_occ[slot] = 0;
+        s_pso_use_key[slot] = 0;
+        pso_coverage_truncate_locked();
+        goto done;
+    }
+    pso_coverage_truncate_locked();
+done:
+    ReleaseSRWLockExclusive(&s_pso_use_lock);
+}
+static void pso_coverage_summary(int force)
+{
+    static ULONGLONG last;
+    ULONGLONG now;
+    if (!pso_coverage_on()) return;
+    now = GetTickCount64();
+    if (!force) {
+        if (last && now - last < 5000) return;
+        last = now;
+    }
+    AcquireSRWLockExclusive(&s_pso_use_lock);
+    pso_coverage_snapshot_locked();
+    ReleaseSRWLockExclusive(&s_pso_use_lock);
+}
