+    }
+    if (levels != s_effect_last[i] || (levels && now - s_effect_sent[i] >= PAD_RUMBLE_RENEW_MS)) {
+        if (triggers && s_sdl.GameControllerRumbleTriggers && s_sdl.GameControllerHasRumbleTriggers &&
