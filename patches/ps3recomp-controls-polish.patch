+/* Controls polish is neutral by default. Settings become environment values
+ * before input starts; restart applies changes without racing an SDL owner. */
+static int pad_control_int(const char* name, int max)
+{
+    const char* all = getenv("PAD_CONTROLS_POLISH");
+    if (all && !strcmp(all, "0")) return 0;
+    const char* e = getenv(name); char* end;
+    if (!e || !*e) return 0;
+    long n = strtol(e, &end, 10);
+    return *end || n < 0 || n > max ? 0 : (int)n;
+}
+static u8 pad_trigger_response(u8 value, int deadzone, int curve)
+{
+    unsigned floor = (unsigned)deadzone * 255 / 100;
+    unsigned x = value <= floor ? 0 : (value - floor) * 255u / (255u - floor);
+    if (curve == 1) x = (x * x + 127u) / 255u;
+    if (curve == 2) x = (x * (510u - x) + 127u) / 255u;
+    return (u8)x;
+}
+static void pad_shape_triggers(PadHostState* hs)
+{
+    static int dz = -1, curve;
+    if (dz < 0) { dz = pad_control_int("PAD_TRIGGER_DEADZONE", 20);
+                  curve = pad_control_int("PAD_TRIGGER_CURVE", 2); }
+    if (!dz && !curve) return; /* preserve the original digital thresholds too */
+    hs->trigger_l2 = pad_trigger_response(hs->trigger_l2, dz, curve);
+    hs->trigger_r2 = pad_trigger_response(hs->trigger_r2, dz, curve);
+    hs->buttons &= ~(CELL_PAD_CTRL_L2 | CELL_PAD_CTRL_R2);
+    if (hs->trigger_l2) hs->buttons |= CELL_PAD_CTRL_L2;
+    if (hs->trigger_r2) hs->buttons |= CELL_PAD_CTRL_R2;
+}
