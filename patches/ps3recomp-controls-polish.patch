+/* SDL's documented PS5 effect payload (47 bytes). Only trigger flags are set.
+ * Fixed resistance, as in SDL's testgamecontroller example; no telemetry. */
+static void pad_dualsense_packet(u8 packet[47], int on)
+{
+    memset(packet, 0, 47);
+    packet[0] = 0x0c;
+    packet[10] = packet[21] = on ? 0x01 : 0x05;
+    if (on) packet[12] = packet[23] = 110;
+}
+static void pad_sdl_effects(int i, unsigned long long now, int active)
+{
+    void* gc = s_sdl_pad[i];
+    static int adaptive = -1, triggers, body;
+    if (adaptive < 0) { adaptive = pad_control_int("PAD_ADAPTIVE_TRIGGERS", 1);
+                       triggers = pad_control_int("PAD_TRIGGER_RUMBLE", 1);
+                       body = pad_control_int("PAD_SDL_RUMBLE", 1); }
+    if (!gc) return;
+    u32 levels = active ? __atomic_load_n(&s_effect_request[i], __ATOMIC_RELAXED) : 0;
+    if (levels != s_effect_last[i] || (levels && now - s_effect_sent[i] >= PAD_RUMBLE_RENEW_MS)) {
+        if (body && s_sdl.GameControllerRumble)
+            s_sdl.GameControllerRumble(gc, (u16)levels, (u16)(levels >> 16), PAD_RUMBLE_HOLD_MS);
+        if (triggers && s_sdl.GameControllerRumbleTriggers && s_sdl.GameControllerHasRumbleTriggers &&
+            s_sdl.GameControllerHasRumbleTriggers(gc))
+            s_sdl.GameControllerRumbleTriggers(gc, (u16)levels, (u16)(levels >> 16), PAD_RUMBLE_HOLD_MS);
+        s_effect_last[i] = levels; s_effect_sent[i] = now;
+    }
+    int want = adaptive && active && s_sdl_type[i] == 7;
+    if (want != s_effect_adaptive[i] && (!s_effect_failed[i] || !want) && s_sdl.GameControllerSendEffect) {
+        u8 packet[47]; pad_dualsense_packet(packet, want);
+        if (s_sdl.GameControllerSendEffect(gc, packet, sizeof packet) < 0) {
+            if (!s_effect_failed[i]) printf("[cellPad] port %d: adaptive triggers unavailable\n", i);
+            s_effect_failed[i] = 1;
+            /* A failed enable may still have reached the device. Try a clear
+             * once on deactivation, even when further enables are suppressed. */
+            s_effect_adaptive[i] = want ? -1 : 0;
+        } else s_effect_adaptive[i] = want;
+    }
+    /* A focus/overlay loss must not revive an old vibration on return. */
+    if (!active) __atomic_store_n(&s_effect_request[i], 0, __ATOMIC_RELAXED);
+}
+static int pad_effects_active(unsigned long long now)
+{
+    DWORD pid = 0;
+    GetWindowThreadProcessId(GetForegroundWindow(), &pid);
+    unsigned long long poll = __atomic_load_n(&s_effect_poll_ms, __ATOMIC_RELAXED);
+    return !g_pad_input_blocked && pid == GetCurrentProcessId() && poll && now - poll < 250;
+}
+static void pad_sdl_effects_exit(void)
+{
+    InterlockedExchange(&s_sdl_stop, 1);
+    if (s_sdl_thread) { WaitForSingleObject(s_sdl_thread, INFINITE); CloseHandle(s_sdl_thread); }
+    else for (int i = 0; i < PAD_MAX_HOST_PORTS; i++) pad_sdl_effects(i, GetTickCount64(), 0);
+}
