+        int rc=s_sdl.GameControllerRumble ? s_sdl.GameControllerRumble(gc,(u16)body_levels,(u16)(body_levels>>16),testing?250:PAD_RUMBLE_HOLD_MS) : -1;
+        if (rc<0 && !s_body_error[i]) {
