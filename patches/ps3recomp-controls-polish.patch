+    if (!(active&1)) __atomic_store_n(&s_effect_request[i], 0, __ATOMIC_RELAXED);
+}
+static int pad_effects_active(unsigned long long now)
+{
+    DWORD pid = 0;
+    GetWindowThreadProcessId(GetForegroundWindow(), &pid);
+    unsigned long long poll = __atomic_load_n(&s_effect_poll_ms, __ATOMIC_RELAXED);
+    return pid == GetCurrentProcessId() ? 2 | (!g_pad_input_blocked && poll && now-poll<250 ? 1 : 0) : 0;
+}
